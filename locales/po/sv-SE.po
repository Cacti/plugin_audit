#: setup.php
msgid "Utilities"
msgstr "Tillbehör"

#: setup.php
msgid "Audit Plugin"
msgstr "Granskningsinsticksmodul"

#: setup.php
msgid "Audit Log Settings"
msgstr "Inställningar för granskningslogg"

#: setup.php
msgid "Enable Audit Log"
msgstr "Aktivera granskningsloggen"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Markera den här rutan om du vill att granskningsloggen ska spåra GUI-aktiviteter."

#: setup.php
msgid "Audit Log Retention"
msgstr "Lagring av granskningslogg"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Hur länge önskar du att revisionslogguppgifter ska behållas?"

#: setup.php
msgid "External Audit Log"
msgstr "Aktivera granskningsloggen"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Markera den här rutan om du vill att granskningsloggen ska spåra GUI-aktiviteter."

#: setup.php
msgid "External Audit Log Format"
msgstr "Format för extern granskningslogg"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Välj utdataformat för poster i den externa granskningsloggen."

#: setup.php
msgid "Text"
msgstr "Text"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log Log file  Path"
msgstr "Sökväg till extern granskningsloggfil"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Ange sökvägen till den externa granskningsloggfilen."

#: setup.php
msgid "Authentication Auditing"
msgstr "Autentiseringsgranskning"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Aktivera autentiseringsgranskning"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Välj att fånga nya händelser för inloggning, utloggning, token, lösenordsbyte och nekad auktorisering från och med nu."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Aktivera volymidentifiering för misslyckade inloggningar"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Skicka en global avvikelsehändelse när antalet misslyckade inloggningar i hela installationen överstiger den konfigurerade tröskeln."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Tidsfönster för misslyckade inloggningar (minuter)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Rullande tidsfönster i minuter, från 1 till 1440, som används för att räkna misslyckade inloggningar."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Volymtröskel för misslyckade inloggningar"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Antal misslyckade inloggningar i hela installationen, från 1 till 1000, som utlöser en global avvikelsehändelse."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Batchstorlek för import av användarlogg"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Högsta antal rader från user_log som importeras och utgångna markeringar som återtas per poller-cykel, från 1 till 5000. Markeringstillstånd behålls i sju dagar, så större batchar ökar både den högsta belastningen på pollern och den begränsade storleken på tillståndstabellen för sju dagar."

#: setup.php
msgid "Remote Syslog"
msgstr "Fjärr-Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Aktivera fjärr-Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Köa färdigställda granskningshändelser för leverans till fjärr-Syslog. Den befintliga externa filutmatningen förblir oberoende."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog-mottagare"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Ange en mottagares värdnamn eller IP-adress utan URI-schema, sökväg eller inloggningsuppgifter."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog-port"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Ange 1–65535 eller lämna tomt för att använda 514 för UDP/TCP och 6514 för TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog-transport"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP skickar ett datagram utan bekräftelse. TCP och TLS använder oktetträkningsinramning enligt RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Syslog-format för nyttolast"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Alla format använder ett RFC 5424-huvud. Välj strukturerade RFC 5424-data, CEF eller kompakt JSON för meddelandet."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog-facilitet"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Välj den facilitet som används för att beräkna RFC 5424-prioriteten."

#: setup.php
msgid "Syslog Application Name"
msgstr "Syslog-programnamn"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Utskrivbar ASCII utan blanksteg, högst 48 tecken."

#: setup.php
msgid "Audit Node Identity"
msgstr "Nodidentitet för granskning"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Stabil RFC 5424-värdnamnsidentitet för denna Cacti-nod. Använd inte ett värde som ändras vid omstart."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Tidsgräns för anslutning och skrivning"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Tidsgräns i sekunder, från 1 till 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Största UDP-poststorlek"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Poster som är större än denna bytegräns flyttas till fellådan och trunkeras eller delas aldrig. TCP eller TLS rekommenderas för stora händelser."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA-fil"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Valfritt PEM CA-paket. Verifiering av motpart och värdnamn är alltid aktiverad."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS-klientcertifikat"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Valfritt PEM-klientcertifikat. En klientnyckel måste också konfigureras."

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS-klientens privata nyckel"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Valfri läsbar PEM-sökväg för privat nyckel. Nyckelns innehåll lagras aldrig i granskningshändelser."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Leveranskö för Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Basfördröjning för nytt försök"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Inledande fördröjning för nytt försök i sekunder, från 1 till 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Största fördröjning för nytt försök"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Största fördröjning för nytt försök i sekunder, från basfördröjningen till 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Högsta antal leveransförsök"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Flytta en post till fellådan efter så här många försök, från 1 till 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Batchstorlek för poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Högsta antal förfallna poster som behandlas per poller-cykel, från 1 till 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Varning för ålder på väntande post"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Visa en varning om problem när den äldsta köade posten når denna ålder i sekunder."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Varningsantal för fellåda"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Visa en varning om problem när så här många poster ligger i fellådan."

#: setup.php
msgid "Audit"
msgstr "Revision"

#: setup.php
msgid "Audit Event Log"
msgstr "Revisionshändelselogg"

