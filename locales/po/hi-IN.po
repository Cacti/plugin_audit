#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME। मुद्रण योग्य बिना स्पेस वाला ASCII, अधिकतम 48 वर्ण।"

#: setup.php
msgid "Audit Node Identity"
msgstr "ऑडिट नोड पहचान"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "इस Cacti नोड के लिए स्थिर RFC 5424 होस्टनाम पहचान। ऐसे मान का उपयोग न करें जो पुनरारंभ पर बदल जाता हो।"

#: setup.php
msgid "Connection and Write Timeout"
msgstr "कनेक्शन और लेखन समय-सीमा (Timeout)"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "सेकंड में टाइमआउट, 1 से 30 तक।"

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "अधिकतम UDP रिकॉर्ड आकार"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "इस बाइट सीमा से बड़े रिकॉर्ड डेड-लेटर कर दिए जाते हैं और उन्हें कभी छोटा या विभाजित नहीं किया जाता है। बड़े ईवेंट के लिए TCP या TLS अनुशंसित है।"

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA फ़ाइल"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "वैकल्पिक PEM CA बंडल। पीयर और होस्टनाम सत्यापन हमेशा सक्षम रहते हैं।"

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS क्लाइंट प्रमाणपत्र"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "वैकल्पिक PEM क्लाइंट प्रमाणपत्र। एक क्लाइंट कुंजी भी कॉन्फ़िगर की जानी आवश्यक है।"

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS क्लाइंट निजी कुंजी"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "वैकल्पिक पठनीय PEM निजी-कुंजी पथ। कुंजी की सामग्री कभी भी ऑडिट ईवेंट्स में संग्रहीत नहीं की जाती है।"

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Syslog डिलीवरी कतार"

#: setup.php
msgid "Retry Base Delay"
msgstr "पुनः प्रयास आधार विलंब"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "सेकंड में प्रारंभिक पुनः प्रयास विलंब, 1 से 3600 तक।"

#: setup.php
msgid "Maximum Retry Delay"
msgstr "अधिकतम पुनः प्रयास विलंब"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "सेकंड में अधिकतम पुनः प्रयास विलंब, आधार विलंब से 86400 तक।"

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "अधिकतम डिलीवरी प्रयास"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "इतने प्रयासों के बाद रिकॉर्ड को डेड-लेटर में ले जाएं, 1 से 100 तक।"

#: setup.php
msgid "Poller Batch Size"
msgstr "पोलर (Poller) बैच आकार"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "प्रति पोलर (Poller) चक्र संसाधित होने वाले अधिकतम देय रिकॉर्ड, 1 से 1000 तक।"

#: setup.php
msgid "Pending Age Warning"
msgstr "लंबित आयु चेतावनी"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "जब सबसे पुराना कतारबद्ध रिकॉर्ड सेकंड में इस आयु तक पहुंच जाए तो अस्वस्थ चेतावनी दिखाएं।"

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "डेड-लेटर चेतावनी संख्या"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "जब इतने रिकॉर्ड डेड-लेटर हो जाएं तो अस्वस्थ चेतावनी दिखाएं।"

#: setup.php
msgid "Audit"
msgstr "हिसाब सूचि"

#: setup.php
msgid "Audit Event Log"
msgstr "ऑडिट इवेंट लॉग"

