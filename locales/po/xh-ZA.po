#: includes/functions.php
msgid "Cacti records this outcome before verifying account enabled, realm authorization, or 2FA completion; a session may not have been established."
msgstr "I-Cacti irekhoda esi siphumo phambi kokuqinisekisa ukuba i-akhawunti ivuliwe, ukugunyaziswa kwendawo (realm), okanye ukugqitywa kwe-2FA; iseshoni isenokuba ayikasekwa."

#: includes/functions.php
msgid "No current Cacti path writes this signature; recorded defensively as a possible password change with an unconfirmed outcome."
msgstr "Akukho ndlela yangoku ye-Cacti ebhala le sayina; irekhodwe njengendlela yokuzikhusela yokutshintsha kwephasiwedi okunokwenzeka enesiphumo esingaqinisekiswanga."

#: includes/functions.php
msgid "Cacti user_log result=3 with user_id=0 may be a password change or a failed 2FA challenge; the table cannot disambiguate."
msgstr "I-Cacti user_log result=3 ene-user_id=0 inokuba lutshintsho lwephasiwedi okanye umngeni we-2FA ongaphumelelanga; itheyibhile ayikwazi ukucacisa umahluko."

#: includes/functions.php
