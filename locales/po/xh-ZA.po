#: setup.php
msgid "Utilities"
msgstr "Izixhobo"

#: setup.php
msgid "Audit Plugin"
msgstr "I-Plugin yoPhicotho"

#: setup.php
msgid "Audit Log Settings"
msgstr "Iisetingi zeLogi yoPhicotho"

#: setup.php
msgid "Enable Audit Log"
msgstr "Vula iLogi yoPhicotho"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Phawula le bhokisi, ukuba ufuna iLogi yoPhicotho ilandele imisebenzi ye-GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Ugcino lweLogi yoPhicotho"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Ufuna ukuba amangenelo e-Audit Log agcinwe ixesha elingakanani?"

#: setup.php
msgid "External Audit Log"
msgstr "Ilogi yoPhicotho lwaNgaphandle"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Phawula le bhokisi, ukuba ufuna iLogi yoPhicotho ibhalwe kwifayile yangaphandle."

#: setup.php
msgid "External Audit Log Format"
msgstr "Ifomathi yeLogi yoPhicotho lwaNgaphandle"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Khetha ifomathi yesiphumo seerekhodi zelog yophicotho lwangaphandle."

#: setup.php
msgid "Text"
msgstr "Umbhalo"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Indlela yeFayile yeLogi yoPhicotho lwaNgaphandle"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Faka indlela eya kwifayile yelogi yophicotho lwangaphandle."

#: setup.php
msgid "Authentication Auditing"
msgstr "Uphicotho loQinisekiso"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Vula uPhicotho loQinisekiso"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Khetha ukuthatha iziganeko ezitsha zokungena, ukuphuma, ithokheni, ukutshintsha iphasiwedi, kunye nokwaliwa kwemvume ukusukela ngoku ukuya phambili."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Vula ukuFumanisa uMthamo wokuNgena okuNgaphumelelanga"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Khupha isiganeko esingaqhelekanga jikelele xa umthamo wokungena okungaphumelelanga kulo lonke ufakelo ugqitha kumda omiselweyo."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Ifestile yokuNgena okusileleyo (imizuzu)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Ixesha elijikelezayo ngemizuzu, ukusuka ku-1 ukuya ku-1440, elisetyenziselwa ukubala ungeno olungaphumelelanga."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Umda woMthamo wokuNgena okusileleyo"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Inani lokungena okungaphumelelanga kulo lonke ufakelo, ukusuka ku-1 ukuya ku-1000, eliqalisa isiganeko sesiphosiso sehlabathi jikelele."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Ubungakanani beBatch yoKungeniswa kweLogi yoMsebenzisi"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Ubuninzi bemiqolo ye-user_log efakiweyo kunye neempawu eziphelelwe lixesha ezibuyiselwayo ngomjikelo ngamnye we-Poller, ukusuka ku-1 ukuya ku-5000. Imeko yophawu igcinwa iintsuku ezisixhenxe, ngoko ke iibhetshi ezinkulu zonyusa kokubini umsebenzi ophezulu we-Poller kunye nobungakanani obulinganiselweyo betheyibhile yemeko yeentsuku ezisixhenxe."

#: setup.php
msgid "Remote Syslog"
msgstr "I-Syslog eKude"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Vula i-Syslog eKude"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Faka emgceni iziganeko zophicotho ezigqityiweyo ukuze zithunyelwe kwi-Syslog ekude. Imveliso yefayile yangaphandle ekhoyo ihlala izimele."

#: setup.php
msgid "Syslog Receiver"
msgstr "Umamkeli we-Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Faka igama lehosti yomamkeli okanye idilesi ye-IP ngaphandle kweskimu se-URI, indlela, okanye iziqinisekiso."

#: setup.php
msgid "Syslog Port"
msgstr "Iphothi ye-Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Faka u-1-65535, okanye ushiye kungenanto ukuze usebenzise u-514 we-UDP/TCP kunye no-6514 we-TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Uthutho lwe-Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "I-UDP ithumela idatagram enye ngaphandle kwesiqinisekiso sokufumana. I-TCP kunye ne-TLS zisebenzisa ukwakha kwe-RFC 6587 kokubala ii-octet."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Ifomathi yoMthwalo we-Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Zonke iifomathi zisebenzisa i-header ye-RFC 5424. Khetha idatha eyakhiweyo ye-RFC 5424, i-CEF, okanye i-JSON eshwankathelweyo yomyalezo."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "IFasiliti ye-Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Khetha indawo (facility) esetyenziselwa ukubala ukubaluleka kwe-RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Igama leNkqubo ye-Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "I-RFC 5424 APP-NAME. I-ASCII eprintekayo engenasithuba, ukuya kuthi ga kwiimpawu ezingama-48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Isazisi seNodi yoPhicotho"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Isazisi segama lehosti esizinzileyo se-RFC 5424 sale nowudi ye-Cacti. Musa ukusebenzisa ixabiso elitshintshayo ekuqalisweni ngokutsha."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Ixesha lokuPhelisa lokuQhagamshela nokuBhala"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Ixesha lokuphelelwa ngemizuzwana, ukusuka ku-1 ukuya ku-30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Owona Mlinganiselo uPhezulu weRekhodi ye-UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Iirekhodi ezinkulu kunalo mda we-byte zifakwa kwi-dead-letter kwaye azize zinqanyulwe okanye zohlulwe. I-TCP okanye i-TLS iyacetyiswa kwiziganeko ezinkulu."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "IFayile ye-TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Ipakethe ye-PEM CA ekhethwayo. Uqinisekiso lwe-peer kunye negama lehosti zisoloko zivuliwe."

#: setup.php
msgid "TLS Client Certificate"
msgstr "ISiqinisekiso soMxhasi se-TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Isatifikethi somxhasi se-PEM esikhethwayo. Isitshixo somxhasi kufuneka siqwalaselwe kwakhona."

#: setup.php
msgid "TLS Client Private Key"
msgstr "IQhosha laBucala loMxhasi le-TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Indlela yesitshixo sabucala ye-PEM efundekayo ekhethwayo. Iziqulatho zesitshixo azikaze zigcinwe kwiziganeko zophicotho."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Ilayini yokuHanjiswa kwe-Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Ulibaziseko olusisiseko lokuZama kwakhona"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Ulibaziseko lokuqala lokuzama kwakhona ngemizuzwana, ukusuka ku-1 ukuya ku-3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Elona Xesha liPhezulu lokuLibazisa ukuZama kwakhona"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Elona xesha liphezulu lokulibazisa ukuzama kwakhona ngemizuzwana, ukusuka kulibaziseko lwesiseko ukuya ku-86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Ubuninzi beMizamo yokuThumela"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Susa irekhodi uyise kwi-dead-letter emva kweli nani lemizamo, ukusuka ku-1 ukuya ku-100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Ubungakanani beBhetshi ye-Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Ubuninzi beerekhodi ezifunekayo ezicutshungulwa ngomjikelo ngamnye we-Poller, ukusuka ku-1 ukuya ku-1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Isilumkiso soBudala obuSalindileyo"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Bonisa isilumkiso esingaphilanga xa irekhodi endala kakhulu ekumgca ifikelela kolu budala ngemizuzwana."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Inani lezilumkiso ze-Dead-letter"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Bonisa isilumkiso esingaphilanga xa ezi rekhodi zininzi zithunyelwe kwi-dead-letter."

#: setup.php
msgid "Audit"
msgstr "Uphicotho"

#: setup.php
msgid "Audit Event Log"
msgstr "Ilogi yeZiganeko zoPhicotho"

