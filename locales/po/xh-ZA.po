msgstr "Imvume yolawulo lophicotho iyafuneka ukugcina ezi setingi."

#: includes/functions.php
msgid "Authentication auditing was not enabled. Run the audit_auth_indexes.php CLI maintenance command first."
msgstr "Uphicotho loqinisekiso belungavulwanga. Qhuba umyalelo wolondolozo we-CLI i-audit_auth_indexes.php kuqala."

