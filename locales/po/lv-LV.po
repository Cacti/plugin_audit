msgstr "Revīzijas žurnāla iestatījumi"

#: setup.php
msgid "Enable Audit Log"
msgstr "Iespējot revīzijas žurnālu"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Atķeksējiet, ja vēlaties, lai revīzijas žurnāls reģistrētu GUI darbības."

#: setup.php
msgid "Audit Log Retention"
msgstr "Revīzijas žurnāla uzglabāšana"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Cik ilgi uzglabāt revīzijas žurnāla ierakstus?"

#: setup.php
msgid "External Audit Log"
msgstr "Iespējot revīzijas žurnālu"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Atķeksējiet, ja vēlaties, lai revīzijas žurnāls reģistrētu GUI darbības."

#: setup.php
msgid "External Audit Log Format"
msgstr "Ārējā audita žurnāla formāts"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Atlasiet izvades formātu ārējā audita žurnāla ierakstiem."

#: setup.php
msgid "Text"
msgstr "Teksts"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Ārējā audita žurnāla faila ceļš"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Ievadiet ceļu uz ārējā audita žurnālfailu."

#: setup.php
msgid "Authentication Auditing"
msgstr "Autentifikācijas audits"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Iespējot autentifikācijas auditu"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Ieslēgt jaunu pieteikšanās, atteikšanās, marķieru, paroles maiņas un autorizācijas atteikuma notikumu reģistrēšanu turpmāk."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Iespējot neveiksmīgo pieteikšanos apjoma noteikšanu"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Ģenerēt globālu anomālijas notikumu, kad neveiksmīgo pieteikšanos apjoms visā instalācijā pārsniedz konfigurēto slieksni."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Neveiksmīgo pieteikšanos logs (minūtēs)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Slīdošais logs minūtēs no 1 līdz 1440, ko izmanto neveiksmīgo pieteikšanos uzskaitei."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Neveiksmīgo pieteikšanos apjoma slieksnis"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Neveiksmīgo pieteikšanos skaits visā instalācijā no 1 līdz 1000, kas izraisa globālu anomālijas notikumu."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Lietotāju žurnāla ielādes paketes lielums"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Maksimālais user_log rindu skaits, kas tiek ielādētas, un beigušos marķieru skaits, kas tiek atbrīvoti vienā aptaujātāja ciklā, no 1 līdz 5000. Marķieru stāvoklis tiek saglabāts septiņas dienas, tāpēc lielākas paketes palielina gan aptaujātāja maksimālo slodzi, gan ierobežotās septiņu dienu stāvokļa tabulas lielumu."

#: setup.php
msgid "Remote Syslog"
msgstr "Attālinātais Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Iespējot attālināto Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Ievietot pabeigtos audita notikumus rindā attālinātajai Syslog piegādei. Esošā ārējā faila izvade paliek neatkarīga."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog saņēmējs"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Ievadiet saņēmēja resursdatora nosaukumu vai IP adresi bez URI shēmas, ceļa vai akreditācijas datiem."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog ports"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Ievadiet 1-65535 vai atstājiet tukšu, lai izmantotu 514 protokoliem UDP/TCP un 6514 protokolam TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog transports"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP nosūta vienu datagrammu bez apstiprinājuma. TCP un TLS izmanto RFC 6587 oktetu skaita kadrēšanu."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Syslog lietderīgās slodzes formāts"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Visi formāti izmanto RFC 5424 galveni. Ziņojumam atlasiet RFC 5424 strukturētos datus, CEF vai kompakto JSON."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog kategorija"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Atlasiet kategoriju, ko izmanto RFC 5424 prioritātes aprēķināšanai."

#: setup.php
msgid "Syslog Application Name"
msgstr "Syslog lietojumprogrammas nosaukums"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Drukājamas ASCII rakstzīmes bez atstarpēm, līdz 48 rakstzīmēm."

#: setup.php
msgid "Audit Node Identity"
msgstr "Audita mezgla identitāte"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Stabila RFC 5424 resursdatora nosaukuma identitāte šim Cacti mezglam. Neizmantojiet vērtību, kas mainās pēc restartēšanas."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Savienojuma un rakstīšanas noildze"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Noildze sekundēs, no 1 līdz 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Maksimālais UDP ieraksta lielums"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Ieraksti, kas pārsniedz šo baitu ierobežojumu, tiek pārvietoti uz nepiegādāto ierakstu rindu un nekad netiek apcirsti vai sadalīti. Lieliem notikumiem ieteicams izmantot TCP vai TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA fails"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Neobligāts PEM CA sertifikātu komplekts. Partnera un resursdatora nosaukuma pārbaude vienmēr ir iespējota."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS klienta sertifikāts"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Neobligāts PEM klienta sertifikāts. Jābūt konfigurētai arī klienta atslēgai."

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS klienta privātā atslēga"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Neobligāts lasāms PEM privātās atslēgas ceļš. Atslēgas saturs nekad netiek saglabāts audita notikumos."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Syslog piegādes rinda"

#: setup.php
msgid "Retry Base Delay"
msgstr "Atkārtota mēģinājuma pamata aizkave"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Sākotnējā atkārtota mēģinājuma aizkave sekundēs, no 1 līdz 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Maksimālā atkārtota mēģinājuma aizkave"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Maksimālā atkārtota mēģinājuma aizkave sekundēs, no pamata aizkaves līdz 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Maksimālais piegādes mēģinājumu skaits"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Pārvietot ierakstu uz nepiegādāto ierakstu rindu pēc šāda mēģinājumu skaita, no 1 līdz 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Aptaujātāja pakešu lielums"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Maksimālais izpildāmo ierakstu skaits, kas tiek apstrādāts vienā aptaujātāja ciklā, no 1 līdz 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Gaidošo ierakstu vecuma brīdinājums"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Rādīt neveselīga stāvokļa brīdinājumu, kad vecākais rindā esošais ieraksts sasniedz šo vecumu sekundēs."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Nepiegādāto ierakstu brīdinājuma skaits"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Rādīt neveselīga stāvokļa brīdinājumu, kad šāds skaits ierakstu ir pārvietots uz nepiegādāto ierakstu rindu."

