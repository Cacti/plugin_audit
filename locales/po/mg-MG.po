#: setup.php
msgid "Utilities"
msgstr "Fitaovana fanampiny"

#: setup.php
msgid "Audit Plugin"
msgstr "Plugin fanaraha-maso"

#: setup.php
msgid "Audit Log Settings"
msgstr "Fandrindrana ny diarin'ny fanaraha-maso"

#: setup.php
msgid "Enable Audit Log"
msgstr "Alefaso ny diarin'ny fanaraha-maso"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Mariho ity boaty ity raha tianao hanara-maso ny hetsika ao amin'ny GUI ny Audit Log."

#: setup.php
msgid "Audit Log Retention"
msgstr "Fitazonana ny diarin'ny fanaraha-maso"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Mandra-pahoviana no tianao hotehirizina ny firaketana Audit Log?"

#: setup.php
msgid "External Audit Log"
msgstr "Tantaran'ny fanaraha-maso ivelany"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Mariho ity boaty ity raha tianao hosoratana any amin'ny rakitra ivelany ny Audit Log."

#: setup.php
msgid "External Audit Log Format"
msgstr "Endriky ny tantaran'ny fanaraha-maso ivelany"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Misafidiana ny endrika fivoahana ho an'ny firaketana fanaraha-maso ivelany."

#: setup.php
msgid "Text"
msgstr "Lahatsoratra"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Lalan'ny rakitry ny tantaran'ny fanaraha-maso ivelany"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Ampidiro ny lalana mankany amin'ny rakitra tatitra fanamarinana ivelany."

#: setup.php
msgid "Authentication Auditing"
msgstr "Fanaraha-maso ny fanamarinana"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Alefaso ny fanaraha-maso ny fanamarinana"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Misafidiana handray ireo tranga vaovao momba ny fidirana, fivoahana, mari-pamantarana, fanovana tenimiafina, ary fandavana alalana manomboka izao."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Alefaso ny fitiliana ny habetsaky ny fidirana tsy nahomby"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Mamoaka hetsika tsy fahatomombanana ankapobeny rehefa mihoatra ny fetra voarindra ny habetsaky ny fidirana tsy nahomby manerana ny fametrahana."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Elanelam-potoanan'ny fidirana tsy nahomby (minitra)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Fe-potoana mikisaka amin'ny minitra, manomboka amin'ny 1 ka hatramin'ny 1440, ampiasaina hanisana ny fidirana tsy nahomby."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Fetra fatran'ny fidirana tsy nahomby"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Isan'ny fidirana tsy nahomby manerana ny fametrahana, manomboka amin'ny 1 ka hatramin'ny 1000, izay miteraka hetsika tsy fahatomombanana faobe."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Haben'ny andiany fandraisana ny tatitra mpampiasa"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Andalana user_log farany ambony ampidirina sy marika lany daty alaina indray isaky ny tsingerin'ny poller, manomboka amin'ny 1 ka hatramin'ny 5000. Tehirizina mandritra ny fito andro ny toetry ny marika, ka ny andiany lehibe kokoa dia mampitombo na ny asa faran'izay betsaky ny poller na ny haben'ny tabilao toetra voafetra mandritra ny fito andro."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog lavitra"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Alefaso ny Syslog lavitra"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Ampilaharo ireo hetsika fanaraha-maso vita mba halefa any amin'ny Syslog lavitra. Tsy miankina amin'izany ny famoahana rakitra ivelany efa misy."

#: setup.php
msgid "Syslog Receiver"
msgstr "Mpandray Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Ampidiro anaran'ny mpampiantrano mpandray na adiresy IP tsy misy rafitra URI, lalana, na mari-pamantarana fidirana."

#: setup.php
msgid "Syslog Port"
msgstr "Seranana Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Ampidiro ny 1-65535, na avelao ho banga mba hampiasana ny 514 ho an'ny UDP/TCP ary 6514 ho an'ny TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Fitaterana Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "Mandefa datagrama iray tsy misy fanamafisana ny UDP. Mampiasa rafitra fanisana okte RFC 6587 ny TCP sy ny TLS."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Endriky ny votoatin'ny Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Mampiasa lohapejy RFC 5424 avokoa ny endrika rehetra. Misafidiana angona voarafitra RFC 5424, CEF, na JSON fohy ho an'ny hafatra."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Sokajy (Facility) Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Misafidiana ny sokajy ampiasaina hikajiana ny laharam-pahamehana RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Anaran'ny rindranasa Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Soratra ASCII azo atonta tsy misy elanelana, hatramin'ny tarehin-tsoratra 48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Famantarana ny node fanaraha-maso"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Anaran'ny mpampiantrano RFC 5424 marin-toerana ho an'ity node Cacti ity. Aza mampiasa sanda miova rehefa manomboka indray."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Fetr'andro fifandraisana sy fanoratana"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Fe-potoana farany amin'ny segondra, manomboka amin'ny 1 ka hatramin'ny 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Haben'ny firaketana UDP farany ambony"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Ny firaketana mihoatra io fetran'ny octet io dia alefa any amin'ny dead-letter ary tsy tapahina na zaraina mihitsy. Ny TCP na TLS no soso-kevitra ho an'ny hetsika lehibe."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Rakitra TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Amboara PEM CA safidy. Mavitrika foana ny fanamarinana ny mpiara-miasa sy ny anaran'ny mpampiantrano."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Taratasy fanamarinana mpanjifa TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Taratasy fanamarinana mpanjifa PEM safidy. Tsy maintsy amboarina ihany koa ny fanalahidin'ny mpanjifa."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Lakile manokana mpanjifa TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Lalana mankany amin'ny fanalahidy manokana PEM azo vakiana (safidy). Tsy tahirizina mihitsy ao amin'ny tranga fanaraha-maso ny votoatin'ny fanalahidy."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Laharan'ny fandefasana Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Fotoana fiandrasana fototra alohan'ny fanandramana indray"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Fahatarana voalohany alohan'ny hanandramana indray amin'ny segondra, manomboka amin'ny 1 ka hatramin'ny 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Elanelam-potoana fanandramana indray farany ambony"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Elanelam-potoana fanandramana indray farany ambony amin'ny segondra, manomboka amin'ny elanelam-potoana fototra ka hatramin'ny 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Fanandramana fandefasana farany ambony"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Afindrao any amin'ny lisitry ny hafatra tsy lasa (dead-letter) ny rakitra iray aorian'izay isa andrana izay, manomboka amin'ny 1 ka hatramin'ny 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Haben'ny andian'ny Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Firaketana tonga fotoana farany ambony karakaraina isaky ny tsingerin'ny poller, manomboka amin'ny 1 ka hatramin'ny 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Fampitandremana momba ny faharetan'ny fiandrasana"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Asehoy ny fampitandremana tsy fahatomombanana rehefa mahatratra io faharetana io amin'ny segondra ny firaketana tranainy indrindra ao anaty filaharana."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Isan'ny fampitandremana hafatra tsy lasa"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Asehoy ny fampitandremana tsy fahatomombanana rehefa mahatratra io isa io ny firaketana tsy tafita (dead-lettered)."

#: setup.php
msgid "Audit"
msgstr "Fanaraha-maso"

#: setup.php
msgid "Audit Event Log"
msgstr "Diarin'ny hetsika fanaraha-maso"

