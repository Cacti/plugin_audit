msgid "%d Year"
msgstr "Unyaka ongu-%d"

#: setup.php
#, php-format
msgid "%d Years"
msgstr "Iminyaka engu-%d"

#: setup.php
msgid "Utilities"
msgstr "Izinsiza"

#: setup.php
msgid "Audit Plugin"
msgstr "I-Plugin Yokucwaninga"

#: setup.php
msgid "Audit Log Settings"
msgstr "Izilungiselelo Zelogi Yokucwaninga"

#: setup.php
msgid "Enable Audit Log"
msgstr "Nika amandla Ilogi Yokuhlola"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Maka leli bhokisi, uma ufuna i-Audit Log ilandelele imisebenzi ye-GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Ukugcinwa Kwelogi Yokucwaninga"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Ufisa ukuthi okufakiwe Kwelogi Yokuhlola kugcinwe isikhathi esingakanani?"

#: setup.php
msgid "External Audit Log"
msgstr "Ilogi Yokucwaninga Yangaphandle"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Maka leli bhokisi, uma ufuna i-Audit Log ibhalwe efayeleni langaphandle."

#: setup.php
msgid "External Audit Log Format"
msgstr "Ifomethi Yelogi Yokucwaninga Yangaphandle"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Khetha ifomethi yokukhipha yamarekhodi elogi yokuhlola yangaphandle."

#: setup.php
msgid "Text"
msgstr "Umbhalo"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Indlela Yefayela Lelogi Yokucwaninga Yangaphandle"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Faka indlela eya kufayela lelogi yokuhlola yangaphandle."

#: setup.php
msgid "Authentication Auditing"
msgstr "Ukucwaningwa Kokuqinisekisa"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Nika amandla Ukuhlolwa Kokuqinisekisa"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Khetha ukurekhoda imicimbi emisha yokungena, ukuphuma, ithokheni, ukushintsha iphasiwedi, kanye nokwenqatshwa kwemvume kusukela kuleli phuzu kuya phambili."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Nika amandla Ukutholwa Kwenani Lokungena Okuhlulekile"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Khipha umcimbi wokungajwayelekile womhlaba wonke lapho inani lokungena okuhlulekile kulo lonke ufakelo lidlula umkhawulo omisiwe."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Iwindi Lokungena Okuhlulekile (imizuzu)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Ifasitela elizungezayo ngamaminithi, kusuka ku-1 kuya ku-1440, elisetshenziselwa ukubala ukungena okwehlulekile."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Umkhawulo Wevolumu Yokungena Okuhlulekile"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Isibalo sokungena okwehlulekile kuyo yonke indawo efakiwe, kusuka ku-1 kuya ku-1000, esiqalisa isigameko esingajwayelekile somhlaba wonke."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Usayizi Weqoqo Lokungenisa Ilogi Yomsebenzisi"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Inani eliphezulu lemigqa ye-user_log efakiwe nezimpawu eziphelelwe yisikhathi ezibuyiswayo ngomjikelezo ngamunye we-I-Poller, ukusuka ku-1 kuya ku-5000. Isimo sophawu sigcinwa izinsuku eziyisikhombisa, ngakho amaqoqo amakhulu akhulisa kokubili umsebenzi ophezulu we-I-Poller nosayizi wethebula lesimo elikhawulelwe izinsuku eziyisikhombisa."

#: setup.php
msgid "Remote Syslog"
msgstr "I-Syslog Ekude"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Nika amandla i-Syslog Ekude"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Faka emugqweni izenzakalo zokuhlola eziphothuliwe ukuze zilethwe ku-Syslog ekude. Okuphumayo kwefayela langaphandle okukhona kuhlala kuzimele."

#: setup.php
msgid "Syslog Receiver"
msgstr "Umamukeli we-Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Faka igama lomsingathi womamukeli noma ikheli le-IP ngaphandle kwesikimu se-URI, indlela, noma imininingwane yokungena."

#: setup.php
msgid "Syslog Port"
msgstr "Imbobo ye-Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Faka u-1-65535, noma ushiye kungenalutho ukuze usebenzise u-514 ku-UDP/TCP no-6514 ku-TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Ukuthuthwa kwe-Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "I-UDP ithumela i-datagram eyodwa ngaphandle kokuqinisekiswa. I-TCP ne-TLS zisebenzisa ukwakheka kokubalwa kwama-octet kwe-RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Ifomethi ye-Payload ye-Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Wonke amafomethi asebenzisa unhlokweni we-RFC 5424. Khetha idatha ehlelekile ye-RFC 5424, i-CEF, noma i-JSON ehlangene yomlayezo."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "I-Facility ye-Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Khetha insiza esetshenziselwa ukubala okubalulekile kwe-RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Igama Lohlelo Lokusebenza lwe-Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "I-RFC 5424 APP-NAME. I-ASCII ephrintekayo engenazo izikhala, kufika ezinhlamvwini ezingu-48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Ubunikazi Be-Node Yokucwaninga"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Ubunikazi begama lomsingathi be-RFC 5424 obuzinzile bale node ye-Cacti. Ungasebenzisi inani elishintshayo lapho kuqalwa kabusha."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Isikhathi Sokuphela Kokuxhumana Nokubhala"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Ukuphela kwesikhathi ngamasekhondi, kusukela ku-1 kuya ku-30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Usayizi Ophezulu Werekhodi Le-UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Amarekhodi amakhulu kunalo mkhawulo wamabhayithi abekwa eceleni njengahlulekile futhi awasoze anqunywa noma ahlukaniswe. I-TCP noma i-TLS inconywa ezenzakalweni ezinkulu."

#: setup.php
msgid "Syslog TLS"
msgstr "I-Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Ifayela le-TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Inqwaba ye-PEM CA ongayikhetha. Ukuqinisekiswa kontanga negama lomsingathi kunikwe amandla njalo."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Isitifiketi Seklayenti se-TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Isitifiketi seklayenti se-PEM ongakukhetha. Ukhiye weklayenti nawo kufanele ulungiselelwe."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Ukhiye Oyimfihlo Weklayenti ye-TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Indlela yokhiye oyimfihlo we-PEM ofundekayo ongayikhetha. Okuqukethwe kokhiye akulokothi kugcinwe emicimbini yokucwaninga."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Ulayini Wokulethwa kwe-Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Ukubambezeleka Okuyisisekelo Kokuzama Futhi"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Ukubambezeleka kokuzama kabusha kokuqala ngamasekhondi, kusuka ku-1 kuya ku-3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Ukulibaziseka Okuphezulu Kokuzama Futhi"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Ukulibaziseka okuphezulu kokuzama futhi ngamasekhondi, ukusuka ekulibazisekeni okuyisisekelo kuya ku-86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Imizamo Ephezulu Yokuletha"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Yisa irekhodi ku-dead-letter ngemva kwale mizamo engaka, kusuka ku-1 kuya ku-100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Usayizi Weqoqo le-Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Inani eliphezulu lamarekhodi afanele acutshungulwa ngomjikelezo ngamunye we-I-Poller, ukusuka ku-1 kuya ku-1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Isexwayiso Sobudala Obulindile"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Bonisa isexwayiso sokungaphili kahle uma irekhodi elidala kunawo wonke elisemugqeni lifinyelela kulobu budala ngemizuzwana."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Isibalo Sesexwayiso Somlayezo Ongalethekanga"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Bonisa isexwayiso sokungaphili kahle uma amarekhodi amaningi kangaka afakwe ku-dead-letter."

#: setup.php
msgid "Audit"
msgstr "Ukucwaninga"

#: setup.php
msgid "Audit Event Log"
msgstr "Ilogi Yezenzakalo Zokucwaninga"

