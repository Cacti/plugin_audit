#: includes/functions.php
msgid "Cacti records this outcome before verifying account enabled, realm authorization, or 2FA completion; a session may not have been established."
msgstr "I-Cacti irekhoda lo mphumela ngaphambi kokuqinisekisa ukuthi i-akhawunti inikwe amandla, ukugunyazwa kwendawo, noma ukuqedwa kwe-2FA; kungenzeka iseshini ayisungulwanga."

#: includes/functions.php
msgid "No current Cacti path writes this signature; recorded defensively as a possible password change with an unconfirmed outcome."
msgstr "Ayikho indlela yamanje ye-Cacti ebhala le siginesha; irekhodwe ngokuzivikela njengokushintshwa kwephasiwedi okungenzeka kube khona okunomphumela ongaqinisekisiwe."

#: includes/functions.php
msgid "Cacti user_log result=3 with user_id=0 may be a password change or a failed 2FA challenge; the table cannot disambiguate."
msgstr "Umphumela we-Cacti user_log result=3 one-user_id=0 ungaba ushintsho lwephasiwedi noma inselelo ye-2FA ehlulekile; ithebula alikwazi ukuhlukanisa."

#: includes/functions.php
msgid "Audit administration permission is required to save these settings."
msgstr "Kudingeka imvume yokuphatha ukucwaninga ukuze kulondolozwe lezi zilungiselelo."

#: includes/functions.php
msgid "Authentication auditing was not enabled. Run the audit_auth_indexes.php CLI maintenance command first."
msgstr "Ukucwaningwa kokuqinisekisa bekunganikwanga amandla. Qala ngokusebenzisa umyalo wokunakekela we-CLI we-audit_auth_indexes.php."

