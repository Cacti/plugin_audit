#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Ìparí àkókò ní ìṣẹ́jú-àáyá, láti 1 títí dé 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Ìwọ̀n Àkọsílẹ̀ UDP Tó Pọ̀ Jù Lọ"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Àwọn àkọsílẹ̀ tí ó tóbi ju ààlà báìtì yìí lọ ni a máa ń fi sí àkọsílẹ̀ tí kò lọ àti pé a kì í gé wọn kúrú tàbí pín wọn. A dábàá TCP tàbí TLS fún àwọn ìṣẹ̀lẹ̀ ńlá."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Fáìlì TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Àpò PEM CA àṣàyàn. Ìfìdí ẹlẹgbẹ́ àti orúkọ olùgbàlejò múlẹ̀ máa ń ṣiṣẹ́ nígbà gbogbo."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Ìwé-ẹ̀rí Oníbàárà TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Ìwé-ẹ̀rí oníbàárà PEM àṣàyàn. A tún gbọ́dọ̀ ṣètò kọ́kọ́rọ́ oníbàárà."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Kọ́kọ́rọ́ Àdáni Oníbàárà TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Ọ̀nà kọ́kọ́rọ́ àdáni PEM tí ó ṣeé kà àṣàyàn. A kì í fi àwọn ohun tí ó wà nínú kọ́kọ́rọ́ náà pamọ́ sínú àwọn ìṣẹ̀lẹ̀ àyẹ̀wò láéláé."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Ìlà Ìfìránṣẹ́ Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Ìdádúró Ìpìlẹ̀ Àtúngbìyànjú"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Ìdádúró ìgbìyànjú lẹ́ẹ̀kan sí i àkọ́kọ́ ní ìṣẹ́jú-àáyá, láti 1 títí dé 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Ìdádúró Àtúngbìyànjú Tó Pọ̀ Jù Lọ"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Ìdádúró àtúngbìyànjú tó pọ̀ jù lọ ní ìṣẹ́jú-àáyá, láti ìdádúró ìpìlẹ̀ títí dé 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Ìgbìyànjú Ìfíránṣẹ́ Tó Pọ̀ Jù Lọ"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Gbé àkọsílẹ̀ lọ sí àpò ìkọ̀sílẹ̀ lẹ́yìn iye ìgbìyànjú yìí, láti 1 títí dé 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Ìwọ̀n Ìdìpọ̀ Olùṣàyẹ̀wò"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Àwọn àkọsílẹ̀ tó yẹ tí a ṣiṣẹ́ lé lórí tó pọ̀ jù lọ fún ìyípo Olùṣàyẹ̀wò kọ̀ọ̀kan, láti 1 títí dé 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Ìkìlọ̀ Ọjọ́-orí Ìdúró"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Ṣàfihàn ìkìlọ̀ àìlera nígbà tí àkọsílẹ̀ tí ó pẹ́ jùlọ nínú ìlà bá dé ọjọ́-orí yìí ní ìṣẹ́jú-àáyá."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Ìka Ìkìlọ̀ Ìfiránṣẹ́ tí ó Kùnà"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Ṣàfihàn ìkìlọ̀ àìlera nígbà tí iye àwọn àkọsílẹ̀ yìí bá di àkọsílẹ̀ tí kò ṣeé ránṣẹ́."

#: setup.php
msgid "Audit"
msgstr "Àyẹ̀wò"

#: setup.php
msgid "Audit Event Log"
msgstr "Àkọsílẹ̀ Ìṣẹ̀lẹ̀ Àyẹ̀wò"

