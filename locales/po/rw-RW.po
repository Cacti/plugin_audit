#: includes/functions.php
msgid "Cacti records this outcome before verifying account enabled, realm authorization, or 2FA completion; a session may not have been established."
msgstr "Cacti yandika iki gisubizo mbere yo kugenzura niba konti yafunguwe, uburenganzira bw'igice, cyangwa irangizwa rya 2FA; umwanya w'imikoranire ushobora kuba utaratangijwe."

#: includes/functions.php
msgid "No current Cacti path writes this signature; recorded defensively as a possible password change with an unconfirmed outcome."
msgstr "Nta nzira ya Cacti iriho yandika iyi sinyatire; byanditswe mu buryo bwo kwirinda nk'ihinduka ry'ijambobanga rishoboka rifite ibisubizo bitaremezwa."

#: includes/functions.php
msgid "Cacti user_log result=3 with user_id=0 may be a password change or a failed 2FA challenge; the table cannot disambiguate."
msgstr "Cacti user_log result=3 hamwe na user_id=0 bishobora kuba ari ihindura ry'ijambobanga cyangwa igenzura rya 2FA ritagenze neza; imbonerahamwe ntishobora kubitandukanya."

#: includes/functions.php
msgid "Audit administration permission is required to save these settings."
msgstr "Uburenganzira bwo kuyobora igenzura burakenewe kugira ngo ube wabika aya magenamiterere."

#: includes/functions.php
msgid "Authentication auditing was not enabled. Run the audit_auth_indexes.php CLI maintenance command first."
msgstr "Igenzura ryo kwemeza umwirondoro ntiryari ryafunguwe. Banza ukoreshe itegeko rya CLI ryo gusana audit_auth_indexes.php."

