msgstr "Umuyobozi w'inyandiko y'igenzura"

#: setup.php
msgid "Technical Support"
msgstr "Ubufasha bwa tekiniki"

#: setup.php
msgid "View Audit Log"
msgstr "Reba inyandiko y'igenzura"

#: setup.php
msgid "Allows Administrators to view change activity on the Cacti server.  Administrators can also export the audit log for analysis purposes."
msgstr "Biha abayobozi ubushobozi bwo kureba ibikorwa by'impinduka kuri seriveri ya Cacti.  Abayobozi bashobora kandi kohereza hanze inyandiko y'igenzura kugira ngo bayisesengure."

#: setup.php
msgid "Indefinitely"
msgstr "Mu buryo butagira iherezo"

#: setup.php
