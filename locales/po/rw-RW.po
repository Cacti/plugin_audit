msgstr "Imyaka %d"

#: setup.php
msgid "Utilities"
msgstr "Ibikoresho by'ubufasha"

#: setup.php
msgid "Audit Plugin"
msgstr "Umugereka w'igenzura"

#: setup.php
msgid "Audit Log Settings"
msgstr "Amagenamiterere y'inyandiko y'igenzura"

#: setup.php
msgid "Enable Audit Log"
msgstr "Fungura Inyandiko y'Ubugenzuzi"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Hitamo aka gasanduku, niba wifuza ko Inyandiko y'igenzura ikurikirana ibikorwa bya GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Igihe cyo kubika inyandiko y'igenzura"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Wifuza ko amakuru y'Inyandiko z'Ubugenzuzi abikwa igihe kingana iki?"

#: setup.php
msgid "External Audit Log"
msgstr "Inyandiko y'igenzura yo hanze"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Hitamo aka gasanduku, niba wifuza ko Inyandiko y'igenzura yandikwa muri dosiye yo hanze."

#: setup.php
msgid "External Audit Log Format"
msgstr "Imiterere y'inyandiko y'igenzura yo hanze"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Hitamo imiterere y'ibisohoka ku nyandiko z'ubugenzuzi zisohoka hanze."

#: setup.php
msgid "Text"
msgstr "Umwandiko"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Inzira ya dosiye y'inyandiko y'igenzura yo hanze"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Andika inzira igana kuri dosiye yo hanze y'inyandiko y'igenzura."

#: setup.php
msgid "Authentication Auditing"
msgstr "Igenzura ryo kwemeza umwirondoro"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Fungura Ubugenzuzi bwo Kwemeza Imyirondoro"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Hitamo gufata ibikorwa bishya byo kwinjira, gusohoka, ikimenyetso cy'uburenganzira (token), guhindura ijambobanga, no kwimwa uburenganzira guhera ubu."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Fungura Gutahura Umubare w'Ibyanze Kwinjira"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Kohereza igikorwa cy'ikidasanzwe rusange igihe umubare w'ibyanze kwinjira mu iyinjira ryose urenze urwego ntarengwa rwagenwe."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Igihe cyo kwinjira byanze (iminota)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Igihe gikomeza mu minota, kuva kuri 1 kugeza kuri 1440, gikoreshwa mu kubara kwinjira kutagenze neza."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Urwego ntarengwa rw'umubare wo kwinjira byanze"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Umubare w'igerageza ryo kwinjira ryanze muri sisitemu yose, kuva kuri 1 kugeza ku 1000, utera igikorwa rusange cy'ikibazo kidasanzwe."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Ingano y'icyiciro cyo kwinjiza inyandiko z'abakoresha"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Umubare ntarengwa w'imirongo ya user_log yinjizwa n'ibimenyetso byarengeje igihe bigarurwa kuri buri cyiciro cy'Ikusanyamakuru, kuva kuri 1 kugeza kuri 5000. Imiterere y'ibimenyetso ibikwa iminsi irindwi, bityo ibyiciro binini byongera byombi akazi kenshi k'Ikusanyamakuru n'ingano y'imbonerahamwe y'imiterere y'iminsi irindwi."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog yo Kure"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Fungura Syslog ya Kure"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Shyira ku murongo ibyabaye by'igenzura byarangiye kugira ngo byoherezwe kuri Syslog ya kure. Ibisohoka mu idosiye yo hanze bisanzwe bikomeza kwigenga."

#: setup.php
msgid "Syslog Receiver"
msgstr "Iyakira rya Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Andika izina rya mwakirizi yakira cyangwa aderesi ya IP nta gice cya URI, inzira, cyangwa ibyangombwa byo kwinjira."

#: setup.php
msgid "Syslog Port"
msgstr "Umuyoboro wa Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Andika 1-65535, cyangwa usige harimo ubusa kugira ngo ukoreshe 514 kuri UDP/TCP na 6514 kuri TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Uburyo bwo kohereza Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP yohereza datagramu imwe nta kwemeza kubayeho. TCP na TLS bikoresha uburyo bwa RFC 6587 bwo kubara okite."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Imiterere y'amakuru ya Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Imiterere yose ikoresha umutwe wa RFC 5424. Hitamo amakuru ateguye ya RFC 5424, CEF, cyangwa JSON yegeranye ku butumwa."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Icyiciro cya Syslog (Facility)"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Hitamo ikiciro gikoreshwa mu kubara uburemere bwa RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Izina rya porogaramu ya Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Inyuguti za ASCII zicapika zitagira umwanya, kugeza ku nyuguti 48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Umwirondoro w'igice cy'igenzura"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Umwirondoro uhoraho w'izina rya mwakirizi rya RFC 5424 kuri iyi node ya Cacti. Ntukoreshe agaciro gahinduka igihe hatangiye bundi bushya."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Igihe ntarengwa cyo Guhuza no Kwandika"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Igihe ntarengwa mu masegonda, kuva kuri 1 kugeza kuri 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Ingano ntarengwa y'inyandiko ya UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Inyandiko nini kurusha iyi ntera y'ama-byte zishyirwa mu butumwa bwapfuye kandi ntizigera zikatwa cyangwa ngo zigabanywe. TCP cyangwa TLS birasabwa ku bikorwa binini."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Dosiye ya CA ya TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Umufungo wa PEM CA utari ngombwa. Igenzura ry'uwo muvugana n'izina rya mwakirizi rihora rifunguye."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Impamyabushobozi y'umukiriya ya TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Icyemezo cy'umukiriya cya PEM kitari ngombwa. Urufunguzo rw'umukiriya na rwo rugomba kugenerwa."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Urufunguzo rwihariye rw'umukiriya rwa TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Inzira itari ngombwa isomeka y'urufunguzo bwite rwa PEM. Ibiri mu rufunguzo ntibibikwa na rimwe mu makuru y'igenzura."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Umurongo w'iyoherezwa rya Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Igihe fatizo cyo gutegereza mbere yo kongera kugerageza"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Igihe cyo gutegereza mbere yo kongera kugerageza mu masegonda, kuva kuri 1 kugeza kuri 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Ikererwa ntarengwa ryo kongera kugerageza"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Ikererwa ntarengwa ryo kongera kugerageza mu masegonda, kuva ku ikererwa shingiro kugeza kuri 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Inshuro ntarengwa zo kugerageza kohereza"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Yimure inyandiko mu bubiko bw'ibyananiranye nyuma y'iyi mibare y'igerageza, kuva kuri 1 kugeza ku 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Ingano y'Ikiciro cy'Ikusanyamakuru"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Umubare ntarengwa w'inyandiko zigeze igihe zitunganywa kuri buri cyiciro cy'Ikusanyamakuru, kuva kuri 1 kugeza ku 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Iburira ry'igihe cyo gutegereza"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Erekana iburira ry'ikibazo igihe inyandiko ya kera kurusha izindi ku murongo igeze kuri iki gihe mu masegonda."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Umubare w'iburira ry'ubutumwa butashyikirijwe"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Erekana iburira ry'ikibazo igihe umubare ungana utya w'inyandiko washyizwe ku ruhande nk'udashoboye gutunganywa."

#: setup.php
msgid "Audit"
msgstr "Igenzura"

#: setup.php
msgid "Audit Event Log"
msgstr "Inyandiko y'ibikorwa by'igenzura"

