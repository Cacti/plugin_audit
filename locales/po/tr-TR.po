msgid "Audit Plugin"
msgstr "Denetim Eklentisi"

#: setup.php
msgid "Audit Log Settings"
msgstr "Denetim Günlüğü Ayarları"

#: setup.php
msgid "Enable Audit Log"
msgstr "Denetim Günlüğünü Etkinleştir"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Denetim Günlüğünün GUI etkinliklerini izlemesini istiyorsanız bu kutuyu işaretleyin."

#: setup.php
msgid "Audit Log Retention"
msgstr "Denetim Günlüğü Tutma"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Denetim Günlüğü girişlerinin ne kadar süreyle saklanmasını istersiniz?"

#: setup.php
msgid "External Audit Log"
msgstr "Denetim Günlüğünü Etkinleştir"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Denetim Günlüğünün GUI etkinliklerini izlemesini istiyorsanız bu kutuyu işaretleyin."

#: setup.php
msgid "External Audit Log Format"
msgstr "Harici Denetim Günlüğü Biçimi"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Harici denetim günlüğü kayıtları için çıktı biçimini seçin."

#: setup.php
msgid "Text"
msgstr "Metin"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Harici Denetim Günlüğü Dosya Yolu"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Dış denetim günlüğü dosyasının yolunu girin."

#: setup.php
msgid "Authentication Auditing"
msgstr "Kimlik Doğrulama Denetimi"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Kimlik Doğrulama Denetimini Etkinleştir"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Bu noktadan itibaren yeni oturum açma, oturum kapatma, belirteç, parola değişikliği ve yetki reddi olaylarını yakalamayı etkinleştirin."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Başarısız Oturum Açma Hacmi Algılamayı Etkinleştir"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Kurulum genelindeki başarısız oturum açma hacmi yapılandırılan eşiği aştığında genel bir anomali olayı oluştur."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Başarısız Giriş Zaman Penceresi (dakika)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Başarısız oturum açma girişimlerini saymak için kullanılan, 1 ile 1440 arasında dakika cinsinden kayan pencere."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Başarısız Giriş Hacmi Eşiği"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Genel bir anomali olayını tetikleyen, kurulum genelindeki 1 ile 1000 arasındaki başarısız oturum açma sayısı."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Kullanıcı Günlüğü Alım Toplu İş Boyutu"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Poller döngüsü başına alınan user_log satırlarının ve süresi dolmuş işaretçilerin geri kazanılan azami sayısı (1 ile 5000 arasında). İşaretçi durumu yedi gün boyunca saklanır; bu nedenle daha büyük toplu işlemler hem tepe poller yükünü hem de yedi günlük sınırlı durum tablosu boyutunu artırır."

#: setup.php
msgid "Remote Syslog"
msgstr "Uzak Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Uzak Syslog'u Etkinleştir"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Sonuçlanan denetim olaylarını uzak Syslog teslimi için kuyruğa alın. Mevcut harici dosya çıktısı bağımsız olarak kalır."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog Alıcısı"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "URI şeması, yolu veya kimlik bilgileri olmadan bir alıcı ana bilgisayar adı veya IP adresi girin."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog Bağlantı Noktası"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "1-65535 arasında bir değer girin veya UDP/TCP için 514 ve TLS için 6514 kullanmak üzere boş bırakın."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog Aktarımı"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP, onay olmadan tek bir datagram gönderir. TCP ve TLS, RFC 6587 sekizli sayım çerçevelemesi kullanır."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Syslog Yük Biçimi"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Tüm biçimler bir RFC 5424 üstbilgisi kullanır. Mesaj için RFC 5424 yapılandırılmış veri, CEF veya sıkıştırılmış JSON seçin."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog Tesisi"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "RFC 5424 önceliğini hesaplamak için kullanılan olanağı (facility) seçin."

#: setup.php
msgid "Syslog Application Name"
msgstr "Syslog Uygulama Adı"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. En fazla 48 karakter uzunluğunda, boşluk içermeyen yazdırılabilir ASCII."

#: setup.php
msgid "Audit Node Identity"
msgstr "Denetim Düğümü Kimliği"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Bu Cacti düğümü için kararlı RFC 5424 ana bilgisayar adı kimliği. Yeniden başlatmada değişen bir değer kullanmayın."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Bağlantı ve Yazma Zaman Aşımı"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "1 ile 30 arasında saniye cinsinden zaman aşımı."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Azami UDP Kayıt Boyutu"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Bu bayt sınırından büyük kayıtlar ölü mektup kuyruğuna (dead-letter) alınır ve asla kırpılmaz veya bölünmez. Büyük olaylar için TCP veya TLS önerilir."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA Dosyası"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "İsteğe bağlı PEM CA paketi. Eş ve ana bilgisayar adı doğrulaması her zaman etkindir."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS İstemci Sertifikası"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "İsteğe bağlı PEM istemci sertifikası. Bir istemci anahtarı da yapılandırılmalıdır."

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS İstemci Özel Anahtarı"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "İsteğe bağlı okunabilir PEM özel anahtar yolu. Anahtar içeriği denetim olaylarında hiçbir zaman saklanmaz."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Syslog Teslimat Kuyruğu"

#: setup.php
msgid "Retry Base Delay"
msgstr "Yeniden Deneme Temel Gecikmesi"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Saniye cinsinden ilk yeniden deneme gecikmesi, 1 ile 3600 arasında."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Azami Yeniden Deneme Gecikmesi"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Temel gecikmeden 86400'e kadar saniye cinsinden azami yeniden deneme gecikmesi."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Azami Teslimat Denemesi"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Bu kadar denemeden sonra bir kaydı teslim edilemeyen (dead-letter) kuyruğuna taşı (1 ile 100 arasında)."

#: setup.php
msgid "Poller Batch Size"
msgstr "Poller Toplu İşlem Boyutu"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Poller döngüsü başına işlenecek zamanı gelmiş azami kayıt sayısı (1 ile 1000 arasında)."

#: setup.php
msgid "Pending Age Warning"
msgstr "Bekleme Süresi Uyarısı"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Kuyruktaki en eski kayıt saniye cinsinden bu yaşa ulaştığında sağlıksız uyarısı göster."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "İletilemeyen İleti (Dead-letter) Uyarı Sayısı"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Bu kadar kayıt teslim edilemeyenler (dead-letter) listesine düştüğünde sağlıksız uyarısı göster."

#: setup.php
msgid "Audit"
msgstr "Denetim Günlüğü"

