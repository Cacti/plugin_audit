#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "poller-ის თითოეულ ციკლში ჩატვირთული user_log სტრიქონებისა და გაუქმებული ვადაგასული მარკერების მაქსიმალური რაოდენობა, 1-დან 5000-მდე. მარკერის მდგომარეობა ინახება შვიდი დღის განმავლობაში, ამიტომ უფრო დიდი პაკეტები ზრდის როგორც poller-ის პიკურ დატვირთვას, ისე შვიდდღიანი მდგომარეობის ცხრილის შეზღუდულ ზომას."

#: setup.php
msgid "Remote Syslog"
msgstr "დაშორებული Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "დაშორებული Syslog-ის ჩართვა"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "დასრულებული აუდიტის მოვლენების რიგში ჩაყენება დაშორებულ Syslog-ში მიწოდებისთვის. არსებული გარე ფაილში გამოტანა დამოუკიდებელი რჩება."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog მიმღები"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "შეიყვანეთ მიმღების ჰოსტის სახელი ან IP მისამართი URI სქემის, ბილიკისა და ავტორიზაციის მონაცემების გარეშე."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog პორტი"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "შეიყვანეთ 1-65535, ან დატოვეთ ცარიელი UDP/TCP-ისთვის 514-ის და TLS-ისთვის 6514-ის გამოსაყენებლად."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog ტრანსპორტი"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP აგზავნის ერთ დატაგრამას დადასტურების გარეშე. TCP და TLS იყენებენ RFC 6587 ოქტეტების დათვლის ფრეიმინგს."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Syslog დატვირთვის ფორმატი"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "ყველა ფორმატი იყენებს RFC 5424 სათაურს. შეტყობინებისთვის აირჩიეთ RFC 5424 სტრუქტურირებული მონაცემები, CEF ან კომპაქტური JSON."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog კატეგორია (Facility)"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "აირჩიეთ კატეგორია (facility), რომელიც გამოიყენება RFC 5424 პრიორიტეტის გამოსათვლელად."

#: setup.php
msgid "Syslog Application Name"
msgstr "Syslog აპლიკაციის სახელი"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. ბეჭდვადი ASCII სიმბოლოები გამოტოვების გარეშე, 48 სიმბოლომდე."

#: setup.php
msgid "Audit Node Identity"
msgstr "აუდიტის კვანძის იდენტობა"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "სტაბილური RFC 5424 ჰოსტის სახელის იდენტობა ამ Cacti კვანძისთვის. არ გამოიყენოთ მნიშვნელობა, რომელიც გადატვირთვისას იცვლება."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "კავშირისა და ჩაწერის მოლოდინის დრო"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "მოლოდინის დრო წამებში, 1-დან 30-მდე."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "UDP ჩანაწერის მაქსიმალური ზომა"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "ამ ბაიტების ლიმიტზე დიდი ჩანაწერები გადადის მიუწოდებელთა (dead-letter) სტატუსში და არასოდეს იკვეცება ან იყოფა. დიდი მოვლენებისთვის რეკომენდებულია TCP ან TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA ფაილი"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "არასავალდებულო PEM CA პაკეტი. პარტნიორისა და ჰოსტის სახელის შემოწმება ყოველთვის ჩართულია."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS კლიენტის სერტიფიკატი"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "არასავალდებულო PEM კლიენტის სერტიფიკატი. ასევე უნდა იყოს კონფიგურირებული კლიენტის გასაღები."

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS კლიენტის პირადი გასაღები"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "არასავალდებულო წაკითხვადი PEM პირადი გასაღების ბილიკი. გასაღების შიგთავსი არასოდეს ინახება აუდიტის მოვლენებში."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Syslog მიწოდების რიგი"

#: setup.php
msgid "Retry Base Delay"
msgstr "ხელახალი ცდის საბაზისო დაყოვნება"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "ხელახალი ცდის საწყისი დაყოვნება წამებში, 1-დან 3600-მდე."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "ხელახალი ცდის მაქსიმალური დაყოვნება"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "ხელახალი ცდის მაქსიმალური დაყოვნება წამებში, საბაზისო დაყოვნებიდან 86400-მდე."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "მიწოდების მაქსიმალური მცდელობები"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "ჩანაწერის მიუწოდებელთა (dead-letter) რიგში გადატანა ამ რაოდენობის მცდელობის შემდეგ, 1-დან 100-მდე."

#: setup.php
msgid "Poller Batch Size"
msgstr "Poller-ის პაკეტის ზომა"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "პოლერის ერთ ციკლში დასამუშავებელი ვადამოსული ჩანაწერების მაქსიმალური რაოდენობა, 1-დან 1000-მდე."

#: setup.php
msgid "Pending Age Warning"
msgstr "მოლოდინის ხანდაზმულობის გაფრთხილება"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "არაჯანსაღი მდგომარეობის გაფრთხილების ჩვენება, როდესაც რიგში მყოფი უძველესი ჩანაწერი ამ ასაკს მიაღწევს წამებში."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "დაუმუშავებელი ჩანაწერების გაფრთხილების რაოდენობა"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "არაჯანსაღი მდგომარეობის გაფრთხილების ჩვენება, როდესაც ამდენი ჩანაწერი დაუმუშავებლად (dead-letter) მოინიშნება."

#: setup.php
msgid "Audit"
msgstr "აუდიტი"

#: setup.php
msgid "Audit Event Log"
msgstr "აუდიტის მოვლენის ჟურნალი"

