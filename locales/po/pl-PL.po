msgstr "Narzędzia"

#: setup.php
msgid "Audit Plugin"
msgstr "Wtyczka Audit"

#: setup.php
msgid "Audit Log Settings"
msgstr "Ustawienia dziennika audytu"

#: setup.php
msgid "Enable Audit Log"
msgstr "Włącz dziennik audytu"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Zaznacz to pole wyboru, jeśli chcesz, aby dziennik audytu śledził działania GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Zatrzymywanie dziennika z audytu"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Jak długo chcesz, aby wpisy w dzienniku audytu były przechowywane?"

#: setup.php
msgid "External Audit Log"
msgstr "Zewnętrzny dziennik audytu"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Zaznacz to pole, jeśli chcesz, aby dziennik audytu był zapisywany do pliku zewnętrznego."

#: setup.php
msgid "External Audit Log Format"
msgstr "Format zewnętrznego dziennika audytu"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Wybierz format wyjściowy dla wpisów zewnętrznego dziennika inspekcji."

#: setup.php
msgid "Text"
msgstr "Tekst"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Ścieżka pliku zewnętrznego dziennika audytu"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Wprowadź ścieżkę do pliku dziennika inspekcji zewnętrznej."

#: setup.php
msgid "Authentication Auditing"
msgstr "Audyt uwierzytelniania"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Włącz audyt uwierzytelniania"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Włącz rejestrowanie nowych zdarzeń logowania, wylogowania, tokenów, zmiany hasła i odmowy autoryzacji od tego momentu."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Włącz wykrywanie wolumenu nieudanych logowań"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Emituj globalne zdarzenie anomalii, gdy liczba nieudanych logowań w całej instalacji przekroczy skonfigurowany próg."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Okno nieudanych logowań (minuty)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Ruchome okno czasowe w minutach, od 1 do 1440, używane do zliczania nieudanych logowań."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Próg wolumenu nieudanych logowań"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Liczba nieudanych logowań w całej instalacji, od 1 do 1000, która wyzwala globalne zdarzenie anomalii."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Rozmiar partii przetwarzania dziennika użytkownika"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Maksymalna liczba wierszy user_log pobranych oraz wygasłych znaczników odzyskanych w jednym cyklu pollera, od 1 do 5000. Stan znaczników jest przechowywany przez siedem dni, więc większe partie zwiększają zarówno szczytowe obciążenie pollera, jak i rozmiar ograniczonej siedmiodniowej tabeli stanu."

#: setup.php
msgid "Remote Syslog"
msgstr "Zdalny Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Włącz zdalny Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Kolejkuj sfinalizowane zdarzenia audytu do zdalnego dostarczenia przez Syslog. Istniejące wyjście do pliku zewnętrznego pozostaje niezależne."

#: setup.php
msgid "Syslog Receiver"
msgstr "Odbiorca Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Wprowadź nazwę hosta odbiorcy lub adres IP bez schematu URI, ścieżki ani poświadczeń."

#: setup.php
msgid "Syslog Port"
msgstr "Port Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Wprowadź wartość 1-65535 lub pozostaw puste, aby użyć portu 514 dla UDP/TCP i 6514 dla TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Transport Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP wysyła jeden datagram bez potwierdzenia. TCP i TLS używają ramkowania z liczbą oktetów zgodnie z RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Format ładunku Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Wszystkie formaty używają nagłówka RFC 5424. Wybierz dane strukturalne RFC 5424, CEF lub kompaktowy JSON dla wiadomości."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Kategoria (Facility) Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Wybierz kategorię (facility) używaną do obliczania priorytetu RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Nazwa aplikacji Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Drukowalne znaki ASCII bez spacji, maksymalnie 48 znaków."

#: setup.php
msgid "Audit Node Identity"
msgstr "Tożsamość węzła audytu"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Stała nazwa hosta RFC 5424 identyfikująca ten węzeł Cacti. Nie używaj wartości, która zmienia się po ponownym uruchomieniu."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Limit czasu połączenia i zapisu"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Limit czasu w sekundach, od 1 do 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Maksymalny rozmiar rekordu UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Rekordy przekraczające ten limit bajtów trafiają do kolejki niedostarczonych (dead-letter) i nigdy nie są obcinane ani dzielone. W przypadku dużych zdarzeń zalecany jest protokół TCP lub TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Plik CA TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Opcjonalny pakiet certyfikatów CA w formacie PEM. Weryfikacja partnera i nazwy hosta jest zawsze włączona."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Certyfikat klienta TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Opcjonalny certyfikat klienta w formacie PEM. Klucz klienta również musi być skonfigurowany."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Klucz prywatny klienta TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Opcjonalna ścieżka do odczytywalnego klucza prywatnego w formacie PEM. Zawartość klucza nigdy nie jest zapisywana w zdarzeniach audytu."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Kolejka dostarczania Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Podstawowe opóźnienie ponowienia"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Początkowe opóźnienie ponownej próby w sekundach, od 1 do 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Maksymalne opóźnienie ponowienia"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Maksymalne opóźnienie ponowienia w sekundach, od opóźnienia bazowego do 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Maksymalna liczba prób dostarczenia"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Przenieś rekord do kolejki dead-letter po tylu próbach, od 1 do 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Rozmiar partii pollera"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Maksymalna liczba oczekujących rekordów przetwarzanych w jednym cyklu pollera, od 1 do 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Ostrzeżenie o czasie oczekiwania"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Wyświetl ostrzeżenie o nieprawidłowym stanie, gdy najstarszy rekord w kolejce osiągnie ten wiek w sekundach."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Próg ostrzegawczy niedostarczonych (Dead-letter)"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Wyświetl ostrzeżenie o nieprawidłowym stanie, gdy tyle rekordów trafi do kolejki niedostarczonych (dead-letter)."

