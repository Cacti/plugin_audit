#: setup.php
msgid "Utilities"
msgstr "Zana"

#: setup.php
msgid "Audit Plugin"
msgstr "Programu-jalizi ya Ukaguzi"

#: setup.php
msgid "Audit Log Settings"
msgstr "Mipangilio ya Kumbukumbu ya Ukaguzi"

#: setup.php
msgid "Enable Audit Log"
msgstr "Washa Kumbukumbu ya Ukaguzi"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Tiki kisanduku hiki, ikiwa unataka Kumbukumbu ya Ukaguzi ifuatilie shughuli za GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Uhifadhi wa Kumbukumbu ya Ukaguzi"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Je, ungependa maingizo ya Kumbukumbu ya Ukaguzi yahifadhiwe kwa muda gani?"

#: setup.php
msgid "External Audit Log"
msgstr "Kumbukumbu ya Ukaguzi wa Nje"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Tiki kisanduku hiki, ikiwa unataka Kumbukumbu ya Ukaguzi iandikwe kwenye faili ya nje."

#: setup.php
msgid "External Audit Log Format"
msgstr "Umbizo la Kumbukumbu ya Ukaguzi wa Nje"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Chagua umbizo la matokeo kwa rekodi za kumbukumbu za ukaguzi za nje."

#: setup.php
msgid "Text"
msgstr "Maandishi"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Njia ya Faili ya Kumbukumbu ya Ukaguzi wa Nje"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Ingiza njia ya faili ya kumbukumbu ya ukaguzi wa nje."

#: setup.php
msgid "Authentication Auditing"
msgstr "Ukaguzi wa Uthibitishaji"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Washa Ukaguzi wa Uthibitishaji"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Kubali kunasa matukio mapya ya kuingia, kutoka, tokeni, kubadilisha nenosiri, na kukataliwa kwa idhini kuanzia sasa na kuendelea."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Washa Ugunduzi wa Kiwango cha Majaribio Yaliyoshindwa ya Kuingia"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Toa tukio la hitilafu ya jumla wakati kiwango cha majaribio yaliyoshindwa ya kuingia katika usakinishaji mzima kinapozidi kizingiti kilichosanidiwa."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Kipindi cha Kuingia Kulikoshindwa (dakika)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Dirisha linalosonga kwa dakika, kuanzia 1 hadi 1440, linalotumika kuhesabu majaribio ya kuingia yaliyoshindwa."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Kizingiti cha Kiasi cha Kuingia Kulikoshindwa"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Idadi ya majaribio ya kuingia yaliyoshindwa katika usakinishaji mzima, kuanzia 1 hadi 1000, ambayo husababisha tukio la hitilafu kwa ujumla."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Ukubwa wa Kundi la Uingizaji wa Kumbukumbu za Mtumiaji"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Idadi ya juu ya safumlalo za user_log zinazoingizwa na alama zilizokwisha muda zinazorejeshwa kwa kila mzunguko wa kikusanyaji, kuanzia 1 hadi 5000. Hali ya alama huhifadhiwa kwa siku saba, kwa hivyo mafungu makubwa huongeza kazi ya kilele ya kikusanyaji na ukubwa wa jedwali la hali la siku saba."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog ya Mbali"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Washa Syslog ya Mbali"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Weka kwenye foleni matukio ya ukaguzi yaliyokamilishwa kwa ajili ya uwasilishaji wa Syslog ya mbali. Towe la faili la nje lililopo linasalia kuwa huru."

#: setup.php
msgid "Syslog Receiver"
msgstr "Kipokezi cha Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Ingiza jina la kipangishi au anwani ya IP ya mpokeaji bila mfumo wa URI, njia, au vitambulisho."

#: setup.php
msgid "Syslog Port"
msgstr "Lango la Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Ingiza 1-65535, au acha wazi ili kutumia 514 kwa UDP/TCP na 6514 kwa TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Usafirishaji wa Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP hutuma datagramu moja bila uthibitisho. TCP na TLS hutumia uundaji wa fremu wa kuhesabu okteti wa RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Umbizo la Data ya Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Miundo yote hutumia kichwa cha RFC 5424. Chagua data iliyopangwa ya RFC 5424, CEF, au JSON fupi kwa ujumbe."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Huduma ya Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Chagua kitengo kinachotumika kukokotoa kipaumbele cha RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Jina la Programu ya Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Herufi za ASCII zinazochapishwa zisizo na nafasi, hadi herufi 48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Utambulisho wa Nodi ya Ukaguzi"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Utambulisho thabiti wa jina la kipangishi la RFC 5424 kwa nodi hii ya Cacti. Usitumie thamani inayobadilika wakati wa kuanzisha upya."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Muda wa Kusubiri wa Muunganisho na Uandishi"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Muda wa kuisha kwa sekunde, kuanzia 1 hadi 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Ukubwa wa Juu wa Rekodi ya UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Rekodi kubwa kuliko kikomo hiki cha baiti huwekwa kwenye foleni ya barua zilizoshindwa na hazikatwi wala kugawanywa kamwe. TCP au TLS inapendekezwa kwa matukio makubwa."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Faili ya TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Kifungu cha CA cha PEM cha hiari. Uthibitishaji wa rika na jina la kipangishi huwashwa kila wakati."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Cheti cha Mteja wa TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Cheti cha mteja cha PEM cha hiari. Ufunguo wa mteja lazima pia usanidiwe."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Ufunguo wa Faragha wa Mteja wa TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Njia ya hiari inayosomeka ya ufunguo wa faragha wa PEM. Maudhui ya ufunguo hayahifadhiwi kamwe katika matukio ya ukaguzi."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Foleni ya Uwasilishaji wa Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Muda wa Msingi wa Kujaribu Tena"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Ucheleweshaji wa awali wa kujaribu tena kwa sekunde, kuanzia 1 hadi 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Muda wa Juu wa Kusubiri Kujaribu Tena"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Muda wa juu wa kusubiri kujaribu tena kwa sekunde, kuanzia ucheleweshaji wa msingi hadi 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Idadi ya Juu ya Majaribio ya Uwasilishaji"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Hamisha rekodi hadi kwenye barua zisizowasilishwa baada ya majaribio haya mengi, kuanzia 1 hadi 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Ukubwa wa Kundi la Kikusanyaji"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Idadi ya juu ya rekodi zinazostahili zinazochakatwa kwa kila mzunguko wa kikusanyaji, kuanzia 1 hadi 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Onyo la Muda wa Kusubiri"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Onyesha onyo la hali isiyo nzuri wakati rekodi kongwe zaidi kwenye foleni inapofikia umri huu kwa sekunde."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Idadi ya Maonyo ya Ujumbe Uliokwama"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Onyesha onyo la hali isiyo nzuri wakati idadi hii ya rekodi imeshindwa kuchakatwa."

#: setup.php
msgid "Audit"
msgstr "Ukaguzi"

#: setup.php
msgid "Audit Event Log"
msgstr "Kumbukumbu ya Matukio ya Ukaguzi"

