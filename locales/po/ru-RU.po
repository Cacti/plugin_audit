msgid "Utilities"
msgstr "Утилиты"

#: setup.php
msgid "Audit Plugin"
msgstr "Плагин Audit"

#: setup.php
msgid "Audit Log Settings"
msgstr "Настройки журнала аудита"

#: setup.php
msgid "Enable Audit Log"
msgstr "Включить журнал аудита"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Отметьте, если вы хотите, чтобы журнал аудита отслеживал активности GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Хранение журнала аудита"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Как долго вы хотите хранить записи в журнале аудита?"

#: setup.php
msgid "External Audit Log"
msgstr "Включить журнал аудита"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Отметьте, если вы хотите, чтобы журнал аудита отслеживал активности GUI."

#: setup.php
msgid "External Audit Log Format"
msgstr "Формат внешнего журнала аудита"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Выберите формат вывода для записей внешнего журнала аудита."

#: setup.php
msgid "Text"
msgstr "Текст"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Путь к внешнему файлу журнала аудита"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Введите путь к файлу журнала внешнего аудита."

#: setup.php
msgid "Authentication Auditing"
msgstr "Аудит аутентификации"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Включить аудит аутентификации"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Включите, чтобы начиная с этого момента регистрировать новые события входа, выхода, работы с токенами, смены пароля и отказа в авторизации."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Включить обнаружение всплесков неудачных входов"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Создавать глобальное событие аномалии, когда общее число неудачных входов в систему превышает заданный порог."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Окно подсчёта неудачных входов (минуты)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Скользящее окно в минутах (от 1 до 1440), используемое для подсчёта неудачных попыток входа."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Порог числа неудачных входов"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Общее по системе количество неудачных входов (от 1 до 1000), вызывающее глобальное событие аномалии."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Размер пакета загрузки журналов пользователей"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Максимальное количество строк user_log, принимаемых и очищаемых от истекших маркеров за один цикл опросчика, от 1 до 5000. Состояние маркеров хранится семь дней, поэтому большие пакеты увеличивают как пиковую нагрузку на опросчик, так и размер таблицы состояний за семь дней."

#: setup.php
msgid "Remote Syslog"
msgstr "Удалённый Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Включить удалённый Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Ставить завершённые события аудита в очередь для удалённой доставки по Syslog. Существующий вывод во внешний файл остаётся независимым."

#: setup.php
msgid "Syslog Receiver"
msgstr "Получатель Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Введите имя узла или IP-адрес получателя без схемы URI, пути или учётных данных."

#: setup.php
msgid "Syslog Port"
msgstr "Порт Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Введите число от 1 до 65535 или оставьте пустым, чтобы использовать 514 для UDP/TCP и 6514 для TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Транспорт Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP отправляет одну дейтаграмму без подтверждения. TCP и TLS используют кадрирование с подсчётом октетов по RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Формат полезной нагрузки Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Все форматы используют заголовок RFC 5424. Выберите для сообщения структурированные данные RFC 5424, CEF или компактный JSON."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Источник (Facility) Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Выберите категорию (facility), используемую для вычисления приоритета RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Имя приложения Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Печатаемые символы ASCII без пробелов, до 48 символов."

#: setup.php
msgid "Audit Node Identity"
msgstr "Идентификатор узла аудита"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Постоянный идентификатор имени хоста RFC 5424 для этого узла Cacti. Не используйте значение, которое изменяется при перезапуске."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Тайм-аут подключения и записи"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Таймаут в секундах (от 1 до 30)."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Максимальный размер UDP-записи"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Записи, превышающие этот предел в байтах, помещаются в очередь недоставленных (dead-letter) и никогда не усекаются и не разбиваются. Для крупных событий рекомендуется TCP или TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Файл ЦС (CA) TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Необязательный пакет сертификатов CA в формате PEM. Проверка узла и имени хоста включена всегда."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Клиентский сертификат TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Необязательный клиентский сертификат в формате PEM. Также должен быть настроен клиентский ключ."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Закрытый ключ клиента TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Необязательный путь к доступному для чтения закрытому ключу в формате PEM. Содержимое ключа никогда не сохраняется в событиях аудита."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Очередь доставки Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Базовая задержка повтора"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Начальная задержка повторной попытки в секундах, от 1 до 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Максимальная задержка повтора"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Максимальная задержка повтора в секундах, от базовой задержки до 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Максимум попыток доставки"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Перемещать запись в очередь недоставленных (dead-letter) после указанного числа попыток, от 1 до 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Размер пакета опросчика"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Максимальное количество готовых к обработке записей за один цикл опросчика, от 1 до 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Предупреждение о длительности ожидания"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Показывать предупреждение о неисправности, когда самая старая запись в очереди достигает этого возраста в секундах."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Количество предупреждений Dead-letter"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Показывать предупреждение о неисправности, когда указанное количество записей попадёт в очередь недоставленных (dead-letter)."

#: setup.php
msgid "Audit"
msgstr "Аудит"

