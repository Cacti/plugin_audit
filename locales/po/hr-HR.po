msgstr "%d godina"

#: setup.php
msgid "Utilities"
msgstr "Uslužni alati"

#: setup.php
msgid "Audit Plugin"
msgstr "Dodatak za reviziju"

#: setup.php
msgid "Audit Log Settings"
msgstr "Postavke zapisnika revizije"

#: setup.php
msgid "Enable Audit Log"
msgstr "Omogući zapisnik revizije"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Označite ovaj okvir ako želite da zapisnik revizije prati GUI aktivnosti."

#: setup.php
msgid "Audit Log Retention"
msgstr "Zadržavanje zapisnika revizije"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Koliko dugo želite da se zapisi zapisnika revizije zadrže?"

#: setup.php
msgid "External Audit Log"
msgstr "Vanjski zapisnik revizije"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Označite ovaj okvir ako želite da se zapisnik revizije zapisuje u vanjsku datoteku."

#: setup.php
msgid "External Audit Log Format"
msgstr "Format vanjskog zapisnika revizije"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Odaberite izlazni format za zapise vanjskog zapisnika revizije."

#: setup.php
msgid "Text"
msgstr "Tekst"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Putanja datoteke vanjskog zapisnika revizije"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Unesite putanju do vanjske datoteke zapisnika revizije."

#: setup.php
msgid "Authentication Auditing"
msgstr "Revizija provjere autentičnosti"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Omogući reviziju provjere autentičnosti"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Uključite prikupljanje novih događaja prijave, odjave, tokena, promjene lozinke i odbijene autorizacije od ovog trenutka nadalje."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Omogući otkrivanje opsega neuspjelih prijava"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Emitiraj globalni događaj anomalije kada opseg neuspjelih prijava u cijeloj instalaciji premaši konfigurirani prag."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Vremenski prozor neuspjelih prijava (minute)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Klizni vremenski prozor u minutama, od 1 do 1440, koji se koristi za brojanje neuspjelih prijava."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Prag opsega neuspjelih prijava"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Broj neuspjelih prijava u cijeloj instalaciji, od 1 do 1000, koji pokreće globalni događaj anomalije."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Veličina paketa za unos korisničkog zapisnika"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Maksimalan broj redaka tablice user_log koji se unose i isteklih oznaka koje se oslobađaju po ciklusu pollera, od 1 do 5000. Stanje oznaka zadržava se sedam dana, pa veći paketi povećavaju i vršno opterećenje pollera i ograničenu veličinu sedmodnevne tablice stanja."

#: setup.php
msgid "Remote Syslog"
msgstr "Udaljeni Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Omogući udaljeni Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Stavi dovršene revizijske događaje u red čekanja za udaljenu Syslog isporuku. Postojeći izlaz u vanjsku datoteku ostaje neovisan."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog primatelj"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Unesite naziv glavnog računala ili IP adresu primatelja bez URI sheme, putanje ili vjerodajnica."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog priključak"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Unesite 1-65535 ili ostavite prazno za korištenje 514 za UDP/TCP i 6514 za TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog prijenos"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP šalje jedan datagram bez potvrde primitka. TCP i TLS koriste RFC 6587 uokvirivanje s brojanjem okteta."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Format korisnog sadržaja za Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Svi formati koriste zaglavlje RFC 5424. Odaberite strukturirane podatke RFC 5424, CEF ili kompaktni JSON za poruku."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog kategorija"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Odaberite kategoriju koja se koristi za izračun prioriteta prema RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Naziv Syslog aplikacije"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Ispisivi ASCII znakovi bez razmaka, do 48 znakova."

#: setup.php
msgid "Audit Node Identity"
msgstr "Identitet čvora revizije"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Stabilan RFC 5424 identitet naziva glavnog računala za ovaj Cacti čvor. Nemojte koristiti vrijednost koja se mijenja pri ponovnom pokretanju."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Istek vremena povezivanja i pisanja"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Istek vremena u sekundama, od 1 do 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Maksimalna veličina UDP zapisa"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Zapisi veći od ovog ograničenja u bajtovima premještaju se u neisporučive zapise i nikada se ne skraćuju niti dijele. Za velike događaje preporučuje se TCP ili TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA datoteka"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Neobvezni PEM CA skup certifikata. Provjera druge strane i naziva glavnog računala uvijek je omogućena."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS klijentski certifikat"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Neobvezni PEM klijentski certifikat. Klijentski ključ također mora biti konfiguriran."

#: setup.php
msgid "TLS Client Private Key"
msgstr "TLS privatni ključ klijenta"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Neobvezna čitljiva putanja do PEM privatnog ključa. Sadržaj ključa nikada se ne pohranjuje u revizijskim događajima."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Red čekanja za Syslog isporuku"

#: setup.php
msgid "Retry Base Delay"
msgstr "Osnovna odgoda ponovnog pokušaja"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Početna odgoda ponovnog pokušaja u sekundama, od 1 do 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Maksimalna odgoda ponovnog pokušaja"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Maksimalna odgoda ponovnog pokušaja u sekundama, od osnovne odgode do 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Maksimalan broj pokušaja isporuke"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Premjesti zapis u neisporučive zapise nakon ovoliko pokušaja, od 1 do 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Veličina paketa pollera"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Maksimalan broj dospjelih zapisa obrađenih po ciklusu pollera, od 1 do 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Upozorenje o starosti na čekanju"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Prikaži upozorenje o neispravnom stanju kada najstariji zapis u redu čekanja dosegne ovu starost u sekundama."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Broj neisporučivih zapisa za upozorenje"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Prikaži upozorenje o neispravnom stanju kada ovoliko zapisa završi kao neisporučivo."

#: setup.php
msgid "Audit"
msgstr "Revizija"

#: setup.php
msgid "Audit Event Log"
msgstr "Zapisnik revizijskih događaja"
