msgstr "Tehnička podrška"

#: setup.php
msgid "View Audit Log"
msgstr "Pregled zapisnika revizije"

#: setup.php
msgid "Allows Administrators to view change activity on the Cacti server.  Administrators can also export the audit log for analysis purposes."
msgstr "Omogućuje administratorima pregled aktivnosti promjena na Cacti poslužitelju. Administratori također mogu izvesti zapisnik revizije u svrhu analize."

#: setup.php
msgid "Indefinitely"
msgstr "Neograničeno"

