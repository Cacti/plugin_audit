#: setup.php
msgid "Utilities"
msgstr "Ferramentas"

#: setup.php
msgid "Audit Plugin"
msgstr "Plugin de auditoria"

#: setup.php
msgid "Audit Log Settings"
msgstr "Configurações do log de auditoria"

#: setup.php
msgid "Enable Audit Log"
msgstr "Ativar log de auditoria"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Marque esta caixa para que o Log de auditoria rastreie as atividades da GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Retenção de logs de auditoria"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Por quanto tempo deseja que as entradas do Log de auditoria sejam mantidas?"

#: setup.php
msgid "External Audit Log"
msgstr "Ativar log de auditoria"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Marque esta caixa para que o Log de auditoria rastreie as atividades da GUI."

#: setup.php
msgid "External Audit Log Format"
msgstr "Formato do log de auditoria externo"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Selecione o formato de saída para os registros do log de auditoria externo."

#: setup.php
msgid "Text"
msgstr "Texto"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Caminho do Arquivo de Log de Auditoria Externo"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Insira o caminho para o arquivo de log de auditoria externa."

#: setup.php
msgid "Authentication Auditing"
msgstr "Auditoria de autenticação"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Habilitar Auditoria de Autenticação"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Habilite para capturar novos eventos de login, logout, token, alteração de senha e autorização negada a partir deste momento."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Habilitar Detecção de Volume de Falhas de Login"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Emitir um evento global de anomalia quando o volume de falhas de login em toda a instalação exceder o limiar configurado."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Janela de Falhas de Login (minutos)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Janela deslizante em minutos, de 1 a 1440, usada para contar logins com falha."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Limiar de Volume de Falhas de Login"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Contagem de falhas de login em toda a instalação, de 1 a 1000, que dispara um evento global de anomalia."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Tamanho do Lote de Ingestão de Logs de Usuário"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Máximo de linhas de user_log ingeridas e marcadores expirados recuperados por ciclo do poller, de 1 a 5000. O estado dos marcadores é retido por sete dias, portanto lotes maiores aumentam tanto o trabalho de pico do poller quanto o tamanho limitado da tabela de estado de sete dias."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog remoto"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Ativar Syslog remoto"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Enfileirar eventos de auditoria finalizados para entrega remota via Syslog. A saída de arquivo externo existente permanece independente."

#: setup.php
msgid "Syslog Receiver"
msgstr "Receptor Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Digite um nome de host ou endereço IP do receptor sem esquema de URI, caminho ou credenciais."

#: setup.php
msgid "Syslog Port"
msgstr "Porta do Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Digite de 1 a 65535 ou deixe em branco para usar 514 para UDP/TCP e 6514 para TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Transporte do Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP envia um datagrama sem confirmação. TCP e TLS usam enquadramento por contagem de octetos da RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Formato do payload do Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Todos os formatos usam um cabeçalho RFC 5424. Selecione dados estruturados RFC 5424, CEF ou JSON compacto para a mensagem."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Facilidade do Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Selecione a facilidade usada para calcular a prioridade RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Nome da aplicação Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "APP-NAME da RFC 5424. ASCII imprimível sem espaços, até 48 caracteres."

#: setup.php
msgid "Audit Node Identity"
msgstr "Identidade do nó de auditoria"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Identidade estável de nome de host RFC 5424 para este nó do Cacti. Não use um valor que mude ao reiniciar."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Tempo limite de conexão e gravação"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Tempo limite em segundos, de 1 a 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Tamanho máximo de registro UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Registros maiores que este limite de bytes são enviados para a fila de mensagens mortas (dead-letter) e nunca são truncados nem divididos. Recomenda-se TCP ou TLS para eventos grandes."

#: setup.php
msgid "Syslog TLS"
msgstr "TLS do Syslog"

#: setup.php
msgid "TLS CA File"
msgstr "Arquivo CA TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Pacote de CA PEM opcional. A verificação de par e de nome do host está sempre ativada."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Certificado de cliente TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Certificado de cliente PEM opcional. Uma chave de cliente também deve ser configurada."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Chave privada do cliente TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Caminho opcional legível da chave privada PEM. O conteúdo da chave nunca é armazenado em eventos de auditoria."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Fila de entrega do Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Atraso base de nova tentativa"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Atraso inicial de nova tentativa em segundos, de 1 a 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Atraso máximo entre tentativas"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Atraso máximo entre tentativas em segundos, do atraso base até 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Máximo de tentativas de entrega"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Mover um registro para dead-letter após esta quantidade de tentativas, de 1 a 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Tamanho do lote do Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Máximo de registros pendentes processados por ciclo do poller, de 1 a 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Aviso de idade pendente"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Exibir um aviso de integridade comprometida quando o registro mais antigo na fila atingir esta idade em segundos."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Contagem de avisos de dead-letter"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Exibir um aviso de integridade comprometida quando esta quantidade de registros estiver na fila de mensagens mortas (dead-letter)."

#: setup.php
msgid "Audit"
msgstr "Auditoria"

