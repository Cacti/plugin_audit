#: setup.php
msgid "Utilities"
msgstr "Adeegyada"

#: setup.php
msgid "Audit Plugin"
msgstr "Lifaaqa Hantidhawrka"

#: setup.php
msgid "Audit Log Settings"
msgstr "Dejinta Diiwaanka Hantidhawrka"

#: setup.php
msgid "Enable Audit Log"
msgstr "Hawlgeli Diiwaanka Hubinta"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Calaamadee sanduuqan, haddii aad rabto in Diiwaanka Hanti-dhawrka uu la socdo hawlaha GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Haynta Diiwaanka Hantidhawrka"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Muddo intee le'eg ayaad rabtaa in la hayo diiwaannada Diiwaanka Hantidhawrka?"

#: setup.php
msgid "External Audit Log"
msgstr "Diiwaanka Hanti-dhawrka Dibadda"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Calaamadee sanduuqan, haddii aad rabto in Diiwaanka Hanti-dhawrka lagu qoro fayl dibadda ah."

#: setup.php
msgid "External Audit Log Format"
msgstr "Qaabka Diiwaanka Hanti-dhawrka Dibadda"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Dooro qaabka wax-soo-saarka ee diiwaannada hanti-dhawrka dibadda."

#: setup.php
msgid "Text"
msgstr "Qoraal"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Jidka Faylka Diiwaanka Hanti-dhawrka Dibadda"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Geli jidka faylka diiwaanka hubinta dibadda."

#: setup.php
msgid "Authentication Auditing"
msgstr "Hantidhawrka Xaqiijinta"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Hawlgeli Hubinta Xaqiijinta"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Dooro in aad duubto dhacdooyinka cusub ee gelitaanka, ka-bixidda, calaamadda (token), beddelka erayga sirta ah, iyo oggolaansho-diidka laga bilaabo hadda wixii ka dambeeya."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Hawlgeli Ogaanshaha Tirada Gelitaanka Fashilmay"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Dir dhacdo aan caadi ahayn oo guud marka tirada gelitaannada fashilmay ee rakibidda oo dhan ay ka badato xadka la habeeyay."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Muddada Galitaanka Fashilmay (daqiiqado)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Muddada wareegaysa oo daqiiqado ah, laga bilaabo 1 ilaa 1440, oo loo adeegsado tirinta gelitaannada fashilmay."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Xadka Mugga Galitaanka Fashilmay"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Tirada gelitaanka fashilmay ee dhammaan rakibaadda, laga bilaabo 1 ilaa 1000, taasoo kicisa dhacdo aan caadi ahayn oo guud."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Cabbirka Kooxda Gelinta Diiwaanka Isticmaalaha"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Safafka user_log ee ugu badan ee la qaato iyo calaamadaha dhacay ee dib loo soo cesho wareeg kasta oo Xog-uruuriye ah, laga bilaabo 1 ilaa 5000. Xaaladda calaamadda waxaa la hayaa toddoba maalmood, sidaas darteed xirmooyinka waaweyn waxay kordhiyaan shaqada ugu sarraysa ee Xog-uruuriyaha iyo cabbirka shaxda xaaladda ee toddobada maalmood ku xaddidan."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog Fog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Hawlgeli Syslog Fog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Saf geli dhacdooyinka hanti-dhawrka ee la dhammeeyay si loogu diro Syslog-ga fog. Wax-soo-saarka faylka dibadda ee jira wuxuu ahaanayaa mid madax-bannaan."

#: setup.php
msgid "Syslog Receiver"
msgstr "Qaatayaha Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Geli magaca martigeliyaha qaataha ama ciwaanka IP iyada oo aan lahayn nidaam URI, jid, ama aqoonsiyo."

#: setup.php
msgid "Syslog Port"
msgstr "Dekedda Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Geli 1-65535, ama bannaanka u daa si aad u isticmaasho 514 ee UDP/TCP iyo 6514 ee TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Gudbinta Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP waxay dirtaa hal xirmo xog ah iyada oo aan oggolaansho sugin. TCP iyo TLS waxay adeegsadaan qaabeynta tirinta-oktetka ee RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Qaabka Xogta (Payload) ee Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Dhammaan qaababku waxay adeegsadaan madaxa RFC 5424. U dooro xogta qaabaysan ee RFC 5424, CEF, ama JSON kooban fariinta."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Qaybta Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Dooro qaybta (facility) loo isticmaalo xisaabinta mudnaanta RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Magaca Barnaamijka Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Xarfaha ASCII ee la daabici karo ee aan meel bannaan lahayn, ilaa 48 xaraf."

#: setup.php
msgid "Audit Node Identity"
msgstr "Aqoonsiga Noodhka Hantidhawrka"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Aqoonsi magac-martigeliye oo xasilloon oo RFC 5424 ah oo loogu talagalay unuggan Cacti. Ha isticmaalin qiime isbeddela marka dib loo bilaabo."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Waqtiga Xidhiidhka iyo Qorista oo Dhammaaday"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Waqti dhammaadka oo ilbiriqsiyo ah, laga bilaabo 1 ilaa 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Cabbirka Diiwaanka UDP ee Ugu Badan"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Diiwaannada ka weyn xadka byte-kan waa la kaydiyaa iyadoo aan la jarin ama la kala qaybin. TCP ama TLS ayaa lagula talinayaa dhacdooyinka waaweyn."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Faylka TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Xirmada PEM CA ee ikhtiyaariga ah. Xaqiijinta asaagga iyo magaca martigeliyaha mar walba waa la hawlgeliyay."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Shahaadada Macmiilka TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Shahaadada macmiilka PEM ee ikhtiyaariga ah. Furaha macmiilka waa in sidoo kale la habeeyaa."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Furaha Gaarka ah ee Macmiilka TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Dariiq furaha gaarka ah ee PEM ee la akhrin karo oo ikhtiyaari ah. Waxyaabaha ku jira furaha waligood laguma keydiyo dhacdooyinka hantidhawrka."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Safka Gaarsiinta Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Dib-u-dhaca Aasaasiga ah ee Isku-dayga"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Dib-u-dhigista isku-dayga bilowga ah oo ilbiriqsiyo ah, laga bilaabo 1 ilaa 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Dib-u-dhaca Isku-dayga ee Ugu Badan"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Dib-u-dhaca isku-dayga ee ugu badan oo ilbiriqsiyo ah, laga bilaabo dib-u-dhaca aasaasiga ah ilaa 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Isku-dayga Dirista ee Ugu Badan"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "U wareeji diiwaanka sanduuqa farriimaha fashilmay ka dib intan oo isku day ah, laga bilaabo 1 ilaa 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Cabbirka Qaybta Xog-uruuriyaha"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Diiwaannada ugu badan ee waqtigoodu dhammaaday ee laga shaqeeyo wareeg kasta oo Xog-uruuriye ah, laga bilaabo 1 ilaa 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Digniinta Da'da Sugitaanka"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Muuji digniin caafimaad-darro marka diiwaanka ugu da'da weyn ee safka ku jira uu gaaro da'dan oo ilbiriqsiyo ah."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Tirada Digniinta Farriimaha aan la gaarsiin"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Muuji digniin caafimaad-darro marka tiradan diiwaannada ah loo diro warqadaha dhintay."

#: setup.php
msgid "Audit"
msgstr "Hantidhawr"

#: setup.php
msgid "Audit Event Log"
msgstr "Diiwaanka Dhacdooyinka Hantidhawrka"

