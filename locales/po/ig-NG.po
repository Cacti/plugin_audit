#: setup.php
msgid "Enable Audit Log"
msgstr "Gbanye Ndekọ Nyocha"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Kaa akara n'igbe a, ma ọ bụrụ na ịchọrọ ka Ndekọ Nnyocha na-eso ihe omume GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Nchekwa Ndekọ Nyocha"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Ogologo oge ole ka ị chọrọ ka edebe ndekọ Nnyocha?"

#: setup.php
msgid "External Audit Log"
msgstr "Ndekọ Nnyocha Mpụga"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Kaa akara n'igbe a, ma ọ bụrụ na ịchọrọ ka e dee Ndekọ Nnyocha na faịlụ mpụga."

#: setup.php
msgid "External Audit Log Format"
msgstr "Ụdị Ndekọ Nnyocha Mpụga"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Họrọ usoro mmepụta maka ndekọ nyocha mpụga."

#: setup.php
msgid "Text"
msgstr "Ederede"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Ụzọ Faịlụ Ndekọ Nnyocha Mpụga"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Tinye ụzọ gaa na faịlụ ndekọ nyocha mpụga."

#: setup.php
msgid "Authentication Auditing"
msgstr "Nyocha Nkwenye"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Gbanye Nyocha Nkwenye"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Họrọ ijide mmemme ọhụrụ nke nbanye, ọpụpụ, token, mgbanwe okwuntụghe, na ịjụ ikike site ugbu a gaa n'ihu."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Gbanye Nchọpụta Ọnụ Ọgụgụ Nbanye Dara Ada"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Zịpụta mmemme ihe na-adịghị mma zuru ụwa ọnụ mgbe ọnụ ọgụgụ nbanye dara ada n'ofe nrụnye niile karịrị ọnụ ụzọ ahaziri."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Oge Nbanye Dara (nkeji)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Windọ na-atụgharị na nkeji, site na 1 ruo 1440, nke a na-eji agụ nbanye dara ada."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Ọnụ ụzọ Ọnụọgụgụ Nbanye Dara"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Ọnụọgụgụ nbanye kụrụ afọ n'ala n'ofe nrụnye niile, site na 1 ruo 1000, nke na-akpalite mmemme ihe na-adịghị mma zuru ụwa ọnụ."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Ogo Otu Nnabata Ndekọ Onye Ọrụ"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Ahịrị user_log kacha elu a nabatara na akara ndị kubiri ume a napụtaghachiri n'otu okirikiri poller, site na 1 ruo 5000. A na-edobe ọnọdụ akara ruo ụbọchị asaa, yabụ nnukwu ogbe na-abawanye ma ọrụ poller kacha elu ma oke tebụl ọnọdụ ụbọchị asaa ahụ."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog Dị N'ebe Dị Anya"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Gbanye Syslog Dị N'ebe Dị Anya"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Tinye ihe omume nyocha emechara n'ahịrị maka nnyefe Syslog dị anya. Mpụta faịlụ mpụga dị ugbu a ka nọrọ onwe ya."

#: setup.php
msgid "Syslog Receiver"
msgstr "Ngwa Nnata Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Tinye aha onye nnabata nke onye nnata ma ọ bụ adreesị IP na-enweghị usoro URI, ụzọ, ma ọ bụ nzere."

#: setup.php
msgid "Syslog Port"
msgstr "Ọdụ Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Tinye 1-65535, ma ọ bụ hapụ oghere iji 514 maka UDP/TCP na 6514 maka TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Mbufe Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP na-ezipu otu datagram na-enweghị nkwenye. TCP na TLS na-eji nhazi ọnụọgụgụ octet RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Nhazi Ibu Ozi Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Ụdị nile na-eji isi okwu RFC 5424. Họrọ data ahaziri ahazi nke RFC 5424, CEF, ma ọ bụ JSON dị nkenke maka ozi ahụ."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Ngalaba Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Họrọ ngalaba eji gbakọọ mkpa RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Aha Ngwa Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. ASCII na-enweghị ohere nke enwere ike ibipụta, ruo mkpụrụedemede 48."

#: setup.php
msgid "Audit Node Identity"
msgstr "Njirimara Nọọdụ Nyocha"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Njirimara aha onye nnabata RFC 5424 kwụsiri ike maka node Cacti a. Ejila uru na-agbanwe mgbe a malitegharịrị."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Oge Mpụta Njikọ na Ide Ihe"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Oge njedebe na sekọnd, site na 1 ruo 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Oke Ndekọ UDP Kacha Elu"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Ndekọ ndị karịrị oke byte a ka a na-etinye na dead-letter ma a naghị ebipụ ha ma ọ bụ kewaa ha. A na-atụ aro TCP ma ọ bụ TLS maka mmemme buru ibu."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Faịlụ TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Ngwugwu PEM CA nke nhọrọ. A na-agbanye nkwenye nke ndị ọgbọ na aha onye nnabata mgbe niile."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Asambodo Onye Ahịa TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Asambodo onye ahịa PEM nke nhọrọ. A ga-ahazirịrị igodo onye ahịa kwa."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Igodo Nzuzo Onye Ahịa TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Ụzọ igodo nzuzo PEM a pụrụ ịgụ nke nhọrọ. A naghị echekwa ọdịnaya igodo ahụ na mmemme nyocha."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Ahịrị Nnyefe Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Oge Nkwụsị Mbụ maka Ịnwa Ọzọ"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Igbu oge mbụ tupu ịnwale ọzọ na sekọnd, site na 1 ruo 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Oge Nchere Nnwalegharị Kacha Elu"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Oge nchere nnwalegharị kacha elu na sekọnd, site na oge nchere ntọala ruo 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Mgbalị Nnyefe Kacha Elu"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Bufee ndekọ n'akwụkwọ ozi nwụrụ anwụ mgbe ọnụọgụgụ mgbalị ndị a gachara, site na 1 ruo 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Ogo Nchịkọta Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Ndekọ ruru oge kacha elu a na-ahazi n'otu okirikiri poller, site na 1 ruo 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Ịdọ aka ná ntị Oge Nchere"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Gosi ịdọ aka ná ntị adịghị mma mgbe ndekọ kacha ochie nọ n'ahịrị ruru afọ a n'ime sekọnd."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Ọnụọgụgụ Ịdọ aka ná ntị Ozi Enweghị Nnyefe"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Gosi ịdọ aka ná ntị adịghị mma mgbe ọnụọgụ ndekọ ndị a nọ n'akwụkwọ ozi nwụrụ anwụ."

#: setup.php
msgid "Audit"
msgstr "Nyocha"

#: setup.php
msgid "Audit Event Log"
msgstr "Ndekọ Ihe Omume Nyocha"

