#: includes/functions.php
msgid "Cacti records this outcome before verifying account enabled, realm authorization, or 2FA completion; a session may not have been established."
msgstr "Cacti na-edekọ nsonaazụ a tupu ya enyocha ma akaụntụ gbanyere, ikike mpaghara (realm), ma ọ bụ mmecha 2FA; o nwere ike ịbụ na e guzobebeghị oge nnọkọ."

#: includes/functions.php
msgid "No current Cacti path writes this signature; recorded defensively as a possible password change with an unconfirmed outcome."
msgstr "Ọ dịghị ụzọ Cacti dị ugbu a na-ede mbinye aka a; edekọrọ ya dị ka nchedo dị ka mgbanwe okwuntụghe nwere ike ime nke nsonaazụ ya akwadoghị."

#: includes/functions.php
msgid "Cacti user_log result=3 with user_id=0 may be a password change or a failed 2FA challenge; the table cannot disambiguate."
msgstr "Cacti user_log result=3 nwere user_id=0 nwere ike ịbụ mgbanwe okwuntụghe ma ọ bụ mgba aka 2FA dara ada; tebụl enweghị ike ịkpa ókè n'etiti ha."

#: includes/functions.php
