#: setup.php
msgid "Utilities"
msgstr "Tiện Ích"

#: setup.php
msgid "Audit Plugin"
msgstr "Plugin kiểm tra (Audit)"

#: setup.php
msgid "Audit Log Settings"
msgstr "Cài đặt nhật ký kiểm toán"

#: setup.php
msgid "Enable Audit Log"
msgstr "Bật nhật ký kiểm toán"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Chọn hộp này, nếu bạn muốn Nhật ký kiểm toán theo dõi các hoạt động GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Lưu giữ nhật ký kiểm toán"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Bạn muốn các mục Nhật ký kiểm toán được giữ lại trong bao lâu?"

#: setup.php
msgid "External Audit Log"
msgstr "Nhật ký kiểm toán bên ngoài"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Chọn hộp này nếu bạn muốn Nhật ký kiểm toán được ghi vào một tệp bên ngoài."

#: setup.php
msgid "External Audit Log Format"
msgstr "Định dạng nhật ký kiểm tra bên ngoài"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Chọn định dạng đầu ra cho các bản ghi nhật ký kiểm tra bên ngoài."

#: setup.php
msgid "Text"
msgstr "Văn bản"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Đường dẫn tệp nhật ký kiểm toán bên ngoài"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Nhập đường dẫn đến tệp nhật ký kiểm tra bên ngoài."

#: setup.php
msgid "Authentication Auditing"
msgstr "Kiểm tra xác thực"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Bật kiểm toán xác thực"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Chọn tham gia để ghi lại các sự kiện đăng nhập, đăng xuất, token, đổi mật khẩu và từ chối cấp quyền mới kể từ thời điểm này trở đi."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Bật phát hiện lượng đăng nhập thất bại"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Phát sự kiện bất thường toàn cục khi số lần đăng nhập thất bại trên toàn hệ thống vượt quá ngưỡng đã cấu hình."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Cửa sổ đăng nhập thất bại (phút)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Cửa sổ trượt tính bằng phút, từ 1 đến 1440, dùng để đếm số lần đăng nhập thất bại."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Ngưỡng số lần đăng nhập thất bại"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Số lần đăng nhập thất bại trên toàn hệ thống, từ 1 đến 1000, để kích hoạt sự kiện bất thường toàn cục."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Kích thước lô thu nhận nhật ký người dùng"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Số hàng user_log tối đa được tiếp nhận và số dấu đánh dấu hết hạn được thu hồi trong mỗi chu kỳ Poller, từ 1 đến 5000. Trạng thái dấu đánh dấu được giữ lại trong bảy ngày, vì vậy lô lớn hơn sẽ làm tăng cả khối lượng công việc đỉnh của Poller và kích thước bảng trạng thái giới hạn bảy ngày."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog từ xa"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Bật Syslog từ xa"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Đưa các sự kiện kiểm toán đã hoàn tất vào hàng đợi để gửi đến Syslog từ xa. Đầu ra tệp bên ngoài hiện có vẫn hoạt động độc lập."

#: setup.php
msgid "Syslog Receiver"
msgstr "Bộ nhận Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Nhập tên máy chủ hoặc địa chỉ IP của bộ nhận không kèm lược đồ URI, đường dẫn hoặc thông tin xác thực."

#: setup.php
msgid "Syslog Port"
msgstr "Cổng Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Nhập 1-65535, hoặc để trống để dùng 514 cho UDP/TCP và 6514 cho TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Giao thức truyền tải Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP gửi một datagram mà không cần xác nhận. TCP và TLS sử dụng đóng khung đếm octet theo RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Định dạng payload Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Mọi định dạng đều sử dụng tiêu đề RFC 5424. Chọn dữ liệu có cấu trúc RFC 5424, CEF hoặc JSON thu gọn cho thông báo."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Facility Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Chọn facility được dùng để tính mức độ ưu tiên RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Tên ứng dụng Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Ký tự ASCII có thể in được không có dấu cách, tối đa 48 ký tự."

#: setup.php
msgid "Audit Node Identity"
msgstr "Danh tính nút kiểm tra"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Định danh tên máy chủ RFC 5424 ổn định cho nút Cacti này. Không sử dụng giá trị thay đổi khi khởi động lại."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Thời gian chờ kết nối và ghi"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Thời gian chờ tính bằng giây, từ 1 đến 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Kích thước bản ghi UDP tối đa"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Các bản ghi lớn hơn giới hạn byte này sẽ bị đưa vào hàng đợi thư lỗi (dead-letter) và không bao giờ bị cắt ngắn hay chia nhỏ. Khuyến nghị dùng TCP hoặc TLS cho các sự kiện lớn."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Tệp CA TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Gói chứng chỉ CA PEM tùy chọn. Tính năng xác minh máy chủ ngang hàng và tên máy chủ luôn được bật."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Chứng chỉ máy khách TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Chứng chỉ ứng dụng khách PEM tùy chọn. Khóa ứng dụng khách cũng phải được cấu hình."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Khóa riêng máy khách TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Đường dẫn khóa riêng tư PEM có thể đọc tùy chọn. Nội dung khóa không bao giờ được lưu trong các sự kiện kiểm toán."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Hàng đợi gửi Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Độ trễ cơ sở khi thử lại"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Độ trễ thử lại ban đầu tính bằng giây, từ 1 đến 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Độ trễ thử lại tối đa"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Độ trễ thử lại tối đa tính bằng giây, từ độ trễ cơ sở đến 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Số lần thử gửi tối đa"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Chuyển bản ghi vào danh sách thư chết (dead-letter) sau số lần thử này, từ 1 đến 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Kích thước lô Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Số bản ghi đến hạn tối đa được xử lý trong mỗi chu kỳ Poller, từ 1 đến 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Cảnh báo thời gian chờ xử lý"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
