msgstr "%d години"

#: setup.php
msgid "Utilities"
msgstr "Приложения"

#: setup.php
msgid "Audit Plugin"
msgstr "Приставка за одит"

#: setup.php
msgid "Audit Log Settings"
msgstr "Настройки на журнал за одит"

#: setup.php
msgid "Enable Audit Log"
msgstr "Активиране на дневник за одит"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Поставете отметка в това квадратче, ако искате дневникът за одит да проследява дейностите на GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "Запазване на регистъра на одитите"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Колко време искате да бъдат запазени записите в регистъра на одита?"

#: setup.php
msgid "External Audit Log"
msgstr "Активиране на дневник за одит"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Поставете отметка в това поле, ако искате дневникът за одит да се записва във външен файл."

#: setup.php
msgid "External Audit Log Format"
msgstr "Формат на външния дневник за одит"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Изберете изходния формат за записите във външния одит журнал."

#: setup.php
msgid "Text"
msgstr "Текст"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Път до външния файл на журнала за одит"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Въведете пътя до регистрационния файл за външна проверка."

#: setup.php
msgid "Authentication Auditing"
msgstr "Одит на удостоверяването"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Активиране на одита на автентикацията"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Активирайте заснемането на нови събития за вход, изход, токен, смяна на парола и отказана оторизация от този момент нататък."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Активиране на откриването на обем от неуспешни влизания"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Изпращане на глобално събитие за аномалия, когато обемът на неуспешните влизания в цялата инсталация надвиши конфигурирания праг."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Времеви прозорец за неуспешни влизания (минути)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Плаващ прозорец в минути, от 1 до 1440, използван за преброяване на неуспешните входове."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Праг за обем от неуспешни влизания"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Общ брой неуспешни влизания за цялата инсталация, от 1 до 1000, който задейства глобално събитие за аномалия."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Размер на пакета за приемане на потребителски журнали"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Максимален брой редове от user_log, поети и с освободени изтекли маркери за един цикъл на Poller, от 1 до 5000. Състоянието на маркерите се съхранява седем дни, така че по-големите партиди увеличават както пиковото натоварване на Poller, така и ограничения седемдневен размер на таблицата със състояния."

#: setup.php
msgid "Remote Syslog"
msgstr "Отдалечен Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Активиране на отдалечен Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Поставяне в опашка на финализираните одитни събития за отдалечена доставка по Syslog. Съществуващият изход към външен файл остава независим."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog получател"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Въведете име на хост или IP адрес на получателя без URI схема, път или данни за достъп."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog порт"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Въведете 1-65535 или оставете празно, за да използвате 514 за UDP/TCP и 6514 за TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog транспорт"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP изпраща една дейтаграма без потвърждение. TCP и TLS използват RFC 6587 рамкиране с брой октети."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Формат на полезния товар за Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Всички формати използват заглавка по RFC 5424. Изберете структурирани данни по RFC 5424, CEF или компактен JSON за съобщението."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog категория (Facility)"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Изберете категорията (facility), използвана за изчисляване на приоритета по RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Име на приложението за Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Печатими ASCII знаци без интервали, до 48 знака."

#: setup.php
msgid "Audit Node Identity"
msgstr "Идентичност на възела за одит"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Устойчиво RFC 5424 име на хост за този Cacti възел. Не използвайте стойност, която се променя при рестартиране."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Време на изчакване при свързване и запис"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Време на изчакване в секунди, от 1 до 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Максимален размер на UDP запис"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Записи, по-големи от това ограничение в байтове, се пренасочват към опашката за недоставени съобщения и никога не се съкращават или разделят. За големи събития се препоръчва TCP или TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Файл с TLS сертифициращ орган (CA)"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Незадължителен PEM CA пакет. Проверката на отсрещната страна и името на хоста винаги са включени."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Клиентски TLS сертификат"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Незадължителен PEM клиентски сертификат. Трябва да бъде конфигуриран и клиентски ключ."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Частен ключ за клиентски TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Незадължителен път до четим PEM файл с частен ключ. Съдържанието на ключа никога не се съхранява в събитията за одит."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Опашка за доставка на Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Начално забавяне при повторен опит"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Начално забавяне преди повторен опит в секунди, от 1 до 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Максимално забавяне при повторен опит"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Максимално забавяне при повторен опит в секунди, от базовото забавяне до 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Максимален брой опити за доставка"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Преместване на запис в опашката за недоставени (dead-letter) след този брой опити, от 1 до 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Размер на пакета на Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Максимален брой дължими записи, обработвани на цикъл на Poller, от 1 до 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Предупреждение за възраст на изчакващи"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Показване на предупреждение за неизправност, когато най-старият запис на опашката достигне тази възраст в секунди."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Праг за предупреждение за недоставени съобщения (Dead-letter)"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Показване на предупреждение за неизправност, когато толкова записи са отхвърлени в dead-letter опашката."

#: setup.php
msgid "Audit"
msgstr "Дневник на одита"

#: setup.php
msgid "Audit Event Log"
msgstr "Протокол за събития на одит"

