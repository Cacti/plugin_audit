msgstr "Tehnička podrška"

#: setup.php
msgid "View Audit Log"
msgstr "Pregled revizijskog zapisnika"

#: setup.php
msgid "Allows Administrators to view change activity on the Cacti server.  Administrators can also export the audit log for analysis purposes."
msgstr "Omogućava administratorima pregled aktivnosti izmjena na Cacti serveru.  Administratori također mogu izvesti revizijski zapisnik u svrhu analize."

#: setup.php
msgid "Indefinitely"
msgstr "Neograničeno"

