#: includes/functions.php
msgid "Cacti records this outcome before verifying account enabled, realm authorization, or 2FA completion; a session may not have been established."
msgstr "Cacti bilježi ovaj ishod prije provjere da li je nalog omogućen, autorizacije područja ili završetka 2FA; sesija možda nije uspostavljena."

#: includes/functions.php
msgid "No current Cacti path writes this signature; recorded defensively as a possible password change with an unconfirmed outcome."
msgstr "Nijedna trenutna Cacti putanja ne zapisuje ovaj potpis; zabilježeno defanzivno kao moguća promjena lozinke s nepotvrđenim ishodom."

#: includes/functions.php
msgid "Cacti user_log result=3 with user_id=0 may be a password change or a failed 2FA challenge; the table cannot disambiguate."
msgstr "Cacti user_log result=3 s user_id=0 može biti promjena lozinke ili neuspješan 2FA izazov; tabela ne može napraviti razliku."

#: includes/functions.php
msgid "Audit administration permission is required to save these settings."
msgstr "Za čuvanje ovih postavki potrebna je dozvola za administraciju revizije."

#: includes/functions.php
msgid "Authentication auditing was not enabled. Run the audit_auth_indexes.php CLI maintenance command first."
msgstr "Revizija autentifikacije nije bila omogućena. Prvo pokrenite CLI naredbu za održavanje audit_auth_indexes.php."

#: includes/functions.php
