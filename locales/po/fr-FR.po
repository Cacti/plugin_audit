#: setup.php
msgid "Utilities"
msgstr "Utilitaires"

#: setup.php
msgid "Audit Plugin"
msgstr "Plugin Audit"

#: setup.php
msgid "Audit Log Settings"
msgstr "Paramètres du journal d'audit"

#: setup.php
msgid "Enable Audit Log"
msgstr "Activer le journal d'audit"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Cochez cette case si vous voulez que le journal d'audit suive les activités de l'interface graphique."

#: setup.php
msgid "Audit Log Retention"
msgstr "Rétention des journaux d'audit"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Combien de temps souhaitez-vous que les entrées du journal d'audit soient conservées ?"

#: setup.php
msgid "External Audit Log"
msgstr "Journal d'audit externe"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Cochez cette case si vous souhaitez que le journal d'audit soit écrit dans un fichier externe."

#: setup.php
msgid "External Audit Log Format"
msgstr "Format du journal d'audit externe"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Sélectionnez le format de sortie pour les enregistrements du journal d'audit externe."

#: setup.php
msgid "Text"
msgstr "Texte"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Chemin du fichier journal d'audit externe"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Entrez le chemin d’accès au fichier journal d’audit externe."

#: setup.php
msgid "Authentication Auditing"
msgstr "Audit d'authentification"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Activer l'audit d'authentification"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Activer la capture des nouveaux événements de connexion, déconnexion, jeton, changement de mot de passe et refus d'autorisation à partir de maintenant."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Activer la détection du volume d'échecs de connexion"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Émettre un événement d'anomalie global lorsque le volume d'échecs de connexion sur l'ensemble de l'installation dépasse le seuil configuré."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Fenêtre de connexions échouées (minutes)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Fenêtre glissante en minutes, de 1 à 1440, utilisée pour compter les échecs de connexion."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Seuil de volume de connexions échouées"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Nombre d'échecs de connexion à l'échelle de l'installation, de 1 à 1000, qui déclenche un événement d'anomalie global."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Taille du lot d'ingestion des journaux utilisateur"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Nombre maximal de lignes user_log ingérées et de marqueurs expirés récupérés par cycle du collecteur, de 1 à 5000. L'état des marqueurs est conservé pendant sept jours ; des lots plus grands augmentent donc à la fois la charge maximale du collecteur et la taille bornée sur sept jours de la table d'état."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog distant"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Activer Syslog distant"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Mettre en file d'attente les événements d'audit finalisés pour l'envoi vers Syslog distant. La sortie vers un fichier externe existante reste indépendante."

#: setup.php
msgid "Syslog Receiver"
msgstr "Récepteur Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Saisissez un nom d'hôte ou une adresse IP de destinataire sans schéma d'URI, chemin ni identifiants."

#: setup.php
msgid "Syslog Port"
msgstr "Port Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Saisissez une valeur entre 1 et 65535, ou laissez vide pour utiliser 514 pour UDP/TCP et 6514 pour TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Transport Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP envoie un datagramme sans accusé de réception. TCP et TLS utilisent le cadrage par comptage d'octets de la RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Format de la charge utile Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Tous les formats utilisent un en-tête RFC 5424. Sélectionnez les données structurées RFC 5424, CEF ou JSON compact pour le message."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Facilité Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Sélectionnez la facilité utilisée pour calculer la priorité RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Nom d'application Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "APP-NAME RFC 5424. Caractères ASCII imprimables sans espace, jusqu'à 48 caractères."

#: setup.php
msgid "Audit Node Identity"
msgstr "Identité du nœud d'audit"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Identité de nom d'hôte RFC 5424 stable pour ce nœud Cacti. N'utilisez pas une valeur qui change au redémarrage."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Délai d'expiration de connexion et d'écriture"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Délai d'expiration en secondes, de 1 à 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Taille maximale d'enregistrement UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Les enregistrements dépassant cette limite en octets sont placés en file de rebut (dead-letter) et ne sont jamais tronqués ni découpés. TCP ou TLS est recommandé pour les événements volumineux."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Fichier CA TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Paquet de certificats CA PEM facultatif. La vérification du pair et du nom d'hôte est toujours activée."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Certificat client TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Certificat client PEM facultatif. Une clé client doit également être configurée."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Clé privée client TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Chemin facultatif et lisible vers la clé privée PEM. Le contenu de la clé n'est jamais stocké dans les événements d'audit."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "File d'envoi Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Délai de base avant réessai"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Délai initial de nouvelle tentative en secondes, de 1 à 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Délai maximal avant nouvelle tentative"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Délai maximal avant nouvelle tentative en secondes, du délai de base jusqu'à 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Nombre maximal de tentatives de remise"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Déplacer un enregistrement vers la file de lettres mortes après ce nombre de tentatives, de 1 à 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Taille de lot du collecteur"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Nombre maximal d'enregistrements dus traités par cycle du collecteur, de 1 à 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Avertissement d'ancienneté en attente"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Afficher un avertissement d'état dégradé lorsque l'enregistrement le plus ancien en file d'attente atteint cet âge en secondes."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Seuil d'avertissement de file de rebut"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Afficher un avertissement d'état dégradé lorsque ce nombre d'enregistrements est placé en file de rebut (dead-letter)."

#: setup.php
msgid "Audit"
msgstr "Audit"

