msgstr "L'autorisation d'administration d'audit est requise pour enregistrer ces paramètres."

#: includes/functions.php
msgid "Authentication auditing was not enabled. Run the audit_auth_indexes.php CLI maintenance command first."
msgstr "L'audit d'authentification n'a pas été activé. Exécutez d'abord la commande de maintenance CLI audit_auth_indexes.php."

