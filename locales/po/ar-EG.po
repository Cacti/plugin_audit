msgid "Utilities"
msgstr "المرافق"

#: setup.php
msgid "Audit Plugin"
msgstr "ملحق التدقيق"

#: setup.php
msgid "Audit Log Settings"
msgstr "إعدادات سجل التدقيق"

#: setup.php
msgid "Enable Audit Log"
msgstr "تمكين سجل التدقيق"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "حدد هذا المربع ، إذا كنت تريد أن يقوم سجل التدوين بتتبع أنشطة واجهة المستخدم الرسومية."

#: setup.php
msgid "Audit Log Retention"
msgstr "مراجعة سجل الاحتفاظ"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "ما المدة التي ترغب في الاحتفاظ بها في إدخالات تدوين السجل؟"

#: setup.php
msgid "External Audit Log"
msgstr "تمكين سجل التدقيق"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "حدد هذا المربع ، إذا كنت تريد أن يقوم سجل التدوين بتتبع أنشطة واجهة المستخدم الرسومية."

#: setup.php
msgid "External Audit Log Format"
msgstr "تنسيق سجل التدقيق الخارجي"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "اختر تنسيق الإخراج لسجلات التدقيق الخارجية."

#: setup.php
msgid "Text"
msgstr "نص"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "مسار ملف سجل التدقيق الخارجي"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "أدخل المسار إلى ملف سجل التدقيق الخارجي."

#: setup.php
msgid "Authentication Auditing"
msgstr "تدقيق المصادقة"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "تفعيل تدقيق المصادقة"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "اشترك لالتقاط أحداث تسجيل الدخول وتسجيل الخروج والرمز وتغيير كلمة المرور ورفض التفويض الجديدة من الآن فصاعدًا."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "تفعيل اكتشاف حجم تسجيل الدخول الفاشل"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "إصدار حدث شذوذ عام عندما يتجاوز حجم محاولات تسجيل الدخول الفاشلة على مستوى التثبيت بأكمله العتبة المكونة."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "نافذة تسجيلات الدخول الفاشلة (بالدقائق)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "نافذة زمنية متحركة بالدقائق، من 1 إلى 1440، تُستخدم لحساب محاولات تسجيل الدخول الفاشلة."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "عتبة حجم تسجيلات الدخول الفاشلة"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "عدد محاولات تسجيل الدخول الفاشلة على مستوى التثبيت، من 1 إلى 1000، الذي يؤدي إلى إطلاق حدث شذوذ عام."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "حجم دفعة استيعاب سجل المستخدم"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "الحد الأقصى لصفوف user_log المستوعبة والعلامات منتهية الصلاحية المستردة في كل دورة مستفتي، من 1 إلى 5000. يتم الاحتفاظ بحالة العلامة لمدة سبعة أيام، لذا فإن الدفعات الأكبر تزيد من ذروة عمل المستفتي وحجم جدول الحالة المحدود بسبعة أيام."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog البعيد"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "تفعيل Syslog البعيد"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "وضع أحداث التدقيق المكتملة في قائمة الانتظار لتسليمها إلى Syslog البعيد. يظل مخرج الملف الخارجي الحالي مستقلاً."

#: setup.php
msgid "Syslog Receiver"
msgstr "مستقبل Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "أدخل اسم مستضيف المستقبل أو عنوان IP بدون مخطط URI أو مسار أو بيانات اعتماد."

#: setup.php
msgid "Syslog Port"
msgstr "منفذ Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "أدخل 1-65535، أو اتركه فارغًا لاستخدام 514 لبروتوكول UDP/TCP و6514 لبروتوكول TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "بروتوكول نقل Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "يرسل UDP حزمة بيانات واحدة دون إقرار بالاستلام. يستخدم كل من TCP وTLS تأطير عدد البايتات وفقاً لمعيار RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "تنسيق حمولة Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "تستخدم جميع التنسيقات ترويسة RFC 5424. حدد بيانات RFC 5424 المهيكلة، أو CEF، أو JSON المضغوط للرسالة."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "مرفق Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "اختر المرفق (facility) المستخدم لحساب أولوية RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "اسم تطبيق Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "اسم التطبيق (APP-NAME) وفق RFC 5424. أحرف ASCII قابلة للطباعة بدون مسافات، بحد أقصى 48 حرفًا."

#: setup.php
msgid "Audit Node Identity"
msgstr "هوية عقدة التدقيق"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "هوية اسم مستضيف RFC 5424 مستقرة لعقدة Cacti هذه. لا تستخدم قيمة تتغير عند إعادة التشغيل."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "مهلة الاتصال والكتابة"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "المهلة بالثواني، من 1 إلى 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "الحد الأقصى لحجم سجل UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "السجلات الأكبر من حد البايت هذا تُرسل إلى قائمة الرسائل غير القابلة للتسليم ولا يتم اقتطاعها أو تقسيمها أبدًا. يُنصح باستخدام TCP أو TLS للأحداث الكبيرة."

#: setup.php
msgid "Syslog TLS"
msgstr "بروتوكول TLS لـ Syslog"

#: setup.php
msgid "TLS CA File"
msgstr "ملف المرجع المصدق CA لـ TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "حزمة PEM CA اختيارية. يكون التحقق من النظير واسم المستضيف Host مفعلًا دائمًا."

#: setup.php
msgid "TLS Client Certificate"
msgstr "شهادة عميل TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "شهادة عميل PEM اختيارية. يجب أيضًا تكوين مفتاح العميل."

#: setup.php
msgid "TLS Client Private Key"
msgstr "المفتاح الخاص لعميل TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "مسار اختياري قابل للقراءة للمفتاح الخاص PEM. لا يتم تخزين محتويات المفتاح أبدًا في أحداث التدقيق."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "قائمة انتظار تسليم Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "التأخير الأساسي لإعادة المحاولة"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "تأخير إعادة المحاولة الأولي بالثواني، من 1 إلى 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "الحد الأقصى لتأخير إعادة المحاولة"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "الحد الأقصى لتأخير إعادة المحاولة بالثواني، بدءًا من التأخير الأساسي وحتى 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "الحد الأقصى لمحاولات التسليم"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "انقل السجل إلى قائمة الرسائل الميتة بعد هذا العدد من المحاولات، من 1 إلى 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "حجم دفعة المستفتي"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "الحد الأقصى للسجلات المستحقة التي تتم معالجتها في كل دورة مستفتي، من 1 إلى 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "تحذير مدة الانتظار"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "إظهار تحذير بعدم السلامة عندما يصل أقدم سجل في قائمة الانتظار إلى هذا العمر بالثواني."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "عدد تحذيرات الرسائل المتعثرة"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "إظهار تحذير بعدم السلامة عندما يصل عدد السجلات الفاشلة (dead-lettered) إلى هذا الحد."

#: setup.php
msgid "Audit"
msgstr "سجل التدقيق"

#: setup.php
msgid "Audit Event Log"
msgstr "تدوين سجل الأحداث"

