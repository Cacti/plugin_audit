#: setup.php
msgid "Utilities"
msgstr "Gereedschappen"

#: setup.php
msgid "Audit Plugin"
msgstr "Audit-plugin"

#: setup.php
msgid "Audit Log Settings"
msgstr "Instellingen auditlogboek"

#: setup.php
msgid "Enable Audit Log"
msgstr "Auditlogboek inschakelen"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Vink dit vakje aan als u wilt dat het auditlogboek de GUI-activiteiten volgt."

#: setup.php
msgid "Audit Log Retention"
msgstr "Audit Logboek Behoud"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Hoe lang wilt u dat de gegevens uit het auditlogboek worden bewaard?"

#: setup.php
msgid "External Audit Log"
msgstr "Auditlogboek inschakelen"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Vink dit vakje aan als u wilt dat het auditlogboek de GUI-activiteiten volgt."

#: setup.php
msgid "External Audit Log Format"
msgstr "Indeling extern auditlogboek"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Selecteer de uitvoerindeling voor externe auditlogrecords."

#: setup.php
msgid "Text"
msgstr "Tekst"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Pad naar extern auditlogbestand"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Voer het pad naar het externe controlelogboekbestand in."

#: setup.php
msgid "Authentication Auditing"
msgstr "Authenticatie-auditing"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Authenticatie-auditing inschakelen"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Kies ervoor om vanaf dit moment nieuwe gebeurtenissen voor aanmelden, afmelden, tokens, wachtwoordwijzigingen en geweigerde autorisaties vast te leggen."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Detectie van aantal mislukte aanmeldingen inschakelen"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Genereer een algemene afwijkingsgebeurtenis wanneer het installatiebrede aantal mislukte aanmeldingen de ingestelde drempelwaarde overschrijdt."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Tijdvenster voor mislukte aanmeldingen (minuten)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Voortschrijdend tijdvenster in minuten, van 1 tot en met 1440, gebruikt om mislukte aanmeldingen te tellen."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Drempelwaarde voor aantal mislukte aanmeldingen"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Installatiebreed aantal mislukte aanmeldingen, van 1 tot en met 1000, dat een globale anomaliegebeurtenis activeert."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Batchgrootte voor opname van gebruikerslogboeken"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Maximumaantal user_log-rijen dat wordt opgenomen en verlopen markeringen dat per poller-cyclus wordt vrijgegeven, van 1 tot en met 5000. De markeringsstatus wordt zeven dagen bewaard, dus grotere batches verhogen zowel de piekbelasting van de poller als de begrensde grootte van de zevendaagse statustabel."

#: setup.php
msgid "Remote Syslog"
msgstr "Externe Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Externe Syslog inschakelen"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Plaats afgeronde auditgebeurtenissen in de wachtrij voor externe Syslog-aflevering. De bestaande externe bestandsuitvoer blijft onafhankelijk."

#: setup.php
msgid "Syslog Receiver"
msgstr "Syslog-ontvanger"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Voer een hostnaam of IP-adres van de ontvanger in zonder URI-schema, pad of referenties."

#: setup.php
msgid "Syslog Port"
msgstr "Syslog-poort"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Voer 1-65535 in, of laat leeg om 514 voor UDP/TCP en 6514 voor TLS te gebruiken."

#: setup.php
msgid "Syslog Transport"
msgstr "Syslog-transport"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP verzendt één datagram zonder bevestiging. TCP en TLS gebruiken RFC 6587 octet-count framing."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Syslog-payloadindeling"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Alle indelingen gebruiken een RFC 5424-header. Selecteer RFC 5424 structured data, CEF of compacte JSON voor het bericht."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Syslog-faciliteit"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Selecteer de faciliteit die wordt gebruikt om de RFC 5424-prioriteit te berekenen."

#: setup.php
msgid "Syslog Application Name"
msgstr "Syslog-applicatienaam"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Afdrukbare ASCII-tekens zonder spaties, maximaal 48 tekens."

#: setup.php
msgid "Audit Node Identity"
msgstr "Auditnode-identiteit"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Stabiele RFC 5424-hostnaamidentiteit voor dit Cacti-knooppunt. Gebruik geen waarde die verandert bij een herstart."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Verbindings- en schrijftime-out"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Time-out in seconden, van 1 tot en met 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Maximale UDP-recordgrootte"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Records die groter zijn dan deze bytelimiet worden als dead-letter gemarkeerd en nooit afgekapt of gesplitst. TCP of TLS wordt aanbevolen voor grote gebeurtenissen."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "TLS CA-bestand"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Optionele PEM CA-bundel. Peer- en hostnaamverificatie zijn altijd ingeschakeld."

#: setup.php
msgid "TLS Client Certificate"
msgstr "TLS-clientcertificaat"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Optioneel PEM-clientcertificaat. Er moet ook een clientsleutel worden geconfigureerd."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Persoonlijke TLS-clientsleutel"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Optioneel leesbaar pad naar PEM-privésleutel. De sleutelinhoud wordt nooit opgeslagen in auditgebeurtenissen."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Syslog-afleverwachtrij"

#: setup.php
msgid "Retry Base Delay"
msgstr "Basisvertraging voor nieuwe poging"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Initiële wachttijd voor opnieuw proberen in seconden, van 1 tot en met 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Maximale wachttijd voor nieuwe poging"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Maximale wachttijd voor nieuwe poging in seconden, vanaf de basisvertraging tot en met 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Maximumaantal afleverpogingen"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Verplaats een record naar dead-letter na dit aantal pogingen, van 1 tot en met 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Poller-batchgrootte"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Maximumaantal vervallen records dat per poller-cyclus wordt verwerkt, van 1 tot en met 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Waarschuwing ouderdom wachtrij"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Toon een statuswaarschuwing wanneer het oudste record in de wachtrij deze leeftijd in seconden bereikt."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Waarschuwingsaantal voor dead-letter"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Toon een statuswaarschuwing wanneer dit aantal records als dead-letter is gemarkeerd."

#: setup.php
msgid "Audit"
msgstr "Controle"

