#: setup.php
msgid "Audit Log Settings"
msgstr "Impostazioni del registro di controllo"

#: setup.php
msgid "Enable Audit Log"
msgstr "Abilita registro di controllo"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Selezionare questa casella se si desidera che l'Audit Log tracci le attività dell'interfaccia grafica."

#: setup.php
msgid "Audit Log Retention"
msgstr "Conservazione del registro di audit"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Per quanto tempo si desidera che le voci del registro di audit vengano mantenute?"

#: setup.php
msgid "External Audit Log"
msgstr "Registro di controllo esterno"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Selezionare questa casella se si desidera che il registro di audit venga scritto su un file esterno."

#: setup.php
#| msgid "External Audit Log"
msgid "External Audit Log Format"
msgstr "Formato del log di controllo esterno"

#: setup.php
#| msgid "Enter the path to the external audit log file."
msgid "Select the output format for external audit log records."
msgstr "Seleziona il formato di output per i record del registro di audit esterno."

#: setup.php
msgid "Text"
msgstr "Testo"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log Log file  Path"
msgstr "Percorso del file di log del log di controllo esterno"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Immettere il percorso del file di registro di controllo esterno."

#: setup.php
msgid "Authentication Auditing"
msgstr "Auditing dell'autenticazione"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Abilita audit di autenticazione"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Attiva l'acquisizione dei nuovi eventi di accesso, disconnessione, token, modifica password e autorizzazione negata da questo momento in poi."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Abilita rilevamento volume accessi non riusciti"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Emette un evento di anomalia globale quando il volume dei tentativi di accesso non riusciti dell'intera installazione supera la soglia configurata."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Finestra accessi falliti (minuti)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Finestra mobile in minuti, da 1 a 1440, usata per contare gli accessi non riusciti."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Soglia volume accessi falliti"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Numero di accessi non riusciti a livello di installazione, da 1 a 1000, che attiva un evento globale di anomalia."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Dimensione batch acquisizione log utente"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Numero massimo di righe user_log acquisite e di marcatori scaduti recuperati per ciclo del Poller, da 1 a 5000. Lo stato dei marcatori viene conservato per sette giorni, quindi batch più grandi aumentano sia il picco di lavoro del Poller sia la dimensione limitata a sette giorni della tabella di stato."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog remoto"

#: setup.php
#| msgid "Enable Audit Log"
msgid "Enable Remote Syslog"
msgstr "Abilita Syslog remoto"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Accoda gli eventi di audit finalizzati per il recapito a Syslog remoto. L'output su file esterno esistente rimane indipendente."

#: setup.php
msgid "Syslog Receiver"
msgstr "Ricevitore Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Inserisci il nome host o l'indirizzo IP del ricevitore senza schema URI, percorso o credenziali."

#: setup.php
msgid "Syslog Port"
msgstr "Porta Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Inserisci un valore tra 1 e 65535 oppure lascia vuoto per utilizzare 514 per UDP/TCP e 6514 per TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Trasporto Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP invia un datagramma senza conferma. TCP e TLS utilizzano il framing octet-count RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Formato payload Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Tutti i formati utilizzano un'intestazione RFC 5424. Selezionare dati strutturati RFC 5424, CEF o JSON compatto per il messaggio."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Facility Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Seleziona la facility usata per calcolare la priorità RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Nome applicazione Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "APP-NAME RFC 5424. Caratteri ASCII stampabili senza spazi, fino a 48 caratteri."

#: setup.php
#| msgid "Audit Log Retention"
msgid "Audit Node Identity"
msgstr "Identità nodo di audit"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Identità hostname RFC 5424 stabile per questo nodo Cacti. Non utilizzare un valore che cambia al riavvio."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Timeout di connessione e scrittura"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Timeout in secondi, da 1 a 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Dimensione massima del record UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "I record più grandi di questo limite in byte vengono spostati nella dead-letter queue e non vengono mai troncati o suddivisi. Per eventi di grandi dimensioni si consiglia TCP o TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "File CA TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Bundle CA PEM opzionale. La verifica del peer e del nome host è sempre abilitata."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Certificato client TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Certificato client PEM opzionale. Deve essere configurata anche una chiave client."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Chiave privata client TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Percorso opzionale leggibile della chiave privata PEM. Il contenuto della chiave non viene mai memorizzato negli eventi di audit."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Coda di consegna Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Ritardo base nuovi tentativi"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Ritardo iniziale dei tentativi in secondi, da 1 a 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Ritardo massimo tra i tentativi"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Ritardo massimo tra i tentativi in secondi, dal ritardo base fino a 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Numero massimo di tentativi di consegna"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Sposta un record in dead-letter dopo questo numero di tentativi, da 1 a 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Dimensione batch Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Numero massimo di record in scadenza elaborati per ciclo del Poller, da 1 a 1000."

#: setup.php
msgid "Pending Age Warning"
msgstr "Avviso anzianità in attesa"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Mostra un avviso di stato anomalo quando il record in coda più vecchio raggiunge questa età in secondi."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Conteggio di avviso dead-letter"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Mostra un avviso di stato anomalo quando questo numero di record finisce in dead-letter."

