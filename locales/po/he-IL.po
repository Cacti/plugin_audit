msgstr "%d שנים"

#: setup.php
msgid "Utilities"
msgstr "כלי עזר"

#: setup.php
msgid "Audit Plugin"
msgstr "תוסף יומן ביקורת"

#: setup.php
msgid "Audit Log Settings"
msgstr "הגדרות יומן ביקורת"

#: setup.php
msgid "Enable Audit Log"
msgstr "הפעל יומן ביקורת"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "סמן תיבה זו, אם ברצונך ש'יומן הביקורת 'יעקוב אחר פעילויות GUI."

#: setup.php
msgid "Audit Log Retention"
msgstr "רישום יומן ביקורת"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "כמה זמן אתה רוצה לשמור רשומות יומן ביקורת?"

#: setup.php
msgid "External Audit Log"
msgstr "הפעל יומן ביקורת"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "סמן תיבה זו, אם ברצונך ש'יומן הביקורת 'יעקוב אחר פעילויות GUI."

#: setup.php
msgid "External Audit Log Format"
msgstr "תבנית יומן ביקורת חיצוני"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "בחר את תבנית הפלט עבור רשומות יומן הביקורת החיצוני."

#: setup.php
msgid "Text"
msgstr "טקסט"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "נתיב קובץ יומן ביקורת חיצוני"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "הזן את הנתיב לקובץ יומן הרישום של הביקורת החיצונית."

#: setup.php
msgid "Authentication Auditing"
msgstr "ביקורת אימות"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "הפעל ביקורת אימות"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "הפעל איסוף של אירועי התחברות, התנתקות, אסימון, שינוי סיסמה ודחיית הרשאה חדשים מנקודה זו ואילך."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "הפעל זיהוי היקף ניסיונות כניסה כושלים"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "הפק אירוע חריגה גלובלי כאשר היקף ניסיונות הכניסה הכושלים בכלל ההתקנה חורג מהסף המוגדר."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "חלון ניסיונות כניסה כושלים (דקות)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "חלון מתגלגל בדקות, מ-1 עד 1440, המשמש לספירת כניסות כושלות."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "סף היקף ניסיונות כניסה כושלים"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "מספר כניסות כושלות בכלל ההתקנה, מ-1 עד 1000, המפעיל אירוע חריגה גלובלי."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "גודל אצווה לקליטת יומן משתמשים"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "מספר השורות המרבי מ-user_log שנקלטות והסמנים שפג תוקפם המפונים בכל מחזור דוגם (Poller), בין 1 ל-5000. מצב הסמנים נשמר למשך שבעה ימים, כך שאצוות גדולות יותר מגדילות הן את עומס השיא של הדוגם והן את גודל טבלת המצב התחום לשבעה ימים."

#: setup.php
msgid "Remote Syslog"
msgstr "Syslog מרוחק"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "הפעל Syslog מרוחק"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "העבר לתור אירועי ביקורת שהושלמו למסירה מרוחקת אל Syslog. פלט הקובץ החיצוני הקיים נשאר בלתי תלוי."

#: setup.php
msgid "Syslog Receiver"
msgstr "מקלט Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "הזן שם מארח או כתובת IP של המקלט ללא סכמת URI, נתיב או פרטי הזדהות."

#: setup.php
msgid "Syslog Port"
msgstr "פורט Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "הזן ערך בין 1-65535, או השאר ריק כדי להשתמש ב-514 עבור UDP/TCP וב-6514 עבור TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "פרוטוקול תעבורה (Transport) של Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP שולח דטגרמה אחת ללא אישור קבלה. TCP ו-TLS משתמשים במסגור ספירת אוקטטים לפי RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "פורמט מטען (Payload) של Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "כל התבניות משתמשות בכותרת RFC 5424. בחר נתונים מובנים של RFC 5424, CEF או JSON דחוס עבור ההודעה."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "מתקן (Facility) של Syslog"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "בחר את ה-Facility המשמש לחישוב העדיפות לפי RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "שם יישום Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. תווי ASCII ניתנים להדפסה ללא רווחים, עד 48 תווים."

#: setup.php
msgid "Audit Node Identity"
msgstr "זהות צומת ביקורת"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "זהות שם מארח (hostname) יציבה לפי RFC 5424 עבור צומת Cacti זה. אל תשתמש בערך המשתנה בעת הפעלה מחדש."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "פסק זמן לחיבור ולכתיבה"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "זמן קצוב בשניות, מ-1 עד 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "גודל רשומת UDP מרבי"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "רשומות הגדולות ממגבלת בתים זו מועברות לטיפול בחריגות (dead-letter) ולעולם אינן נחתכות או מפוצלות. פרוטוקול TCP או TLS מומלץ לאירועים גדולים."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "קובץ CA של TLS"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "חבילת אישורי PEM CA אופציונלית. אימות עמית ושם מארח מופעלים תמיד."

#: setup.php
msgid "TLS Client Certificate"
msgstr "אישור לקוח TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "תעודת לקוח PEM אופציונלית. יש להגדיר גם מפתח לקוח."

#: setup.php
msgid "TLS Client Private Key"
msgstr "מפתח פרטי של לקוח TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "נתיב אופציונלי לקריאת מפתח פרטי מסוג PEM. תוכן המפתח אינו נשמר לעולם באירועי ביקורת."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "תור מסירת Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "השהיית בסיס לניסיון חוזר"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "השהיית ניסיון חוזר ראשונית בשניות, מ-1 עד 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "השהיית ניסיון חוזר מרבית"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "השהייה מרבית לניסיון חוזר בשניות, מהשהיית הבסיס ועד 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "מספר ניסיונות מסירה מרבי"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "העברת רשומה לתיבת הודעות מתות (dead-letter) לאחר מספר ניסיונות זה, מ-1 עד 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "גודל אצוות Poller"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
