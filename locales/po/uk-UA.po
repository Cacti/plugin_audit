msgid "%d Years"
msgstr "%d років"

#: setup.php
msgid "Utilities"
msgstr "Комунальні послуги"

#: setup.php
msgid "Audit Plugin"
msgstr "Плагін аудиту"

#: setup.php
msgid "Audit Log Settings"
msgstr "Налаштування журналу аудиту"

#: setup.php
msgid "Enable Audit Log"
msgstr "Увімкнути журнал аудиту"

#: setup.php
msgid "Check this box, if you want the Audit Log to track GUI activities."
msgstr "Позначте цей прапорець, щоб журнал аудиту відстежував дії у графічному інтерфейсі (GUI)."

#: setup.php
msgid "Audit Log Retention"
msgstr "Зберігання журналу аудиту"

#: setup.php
msgid "How long do you wish Audit Log entries to be retained?"
msgstr "Як довго слід зберігати записи журналу аудиту?"

#: setup.php
msgid "External Audit Log"
msgstr "Зовнішній журнал аудиту"

#: setup.php
msgid "Check this box, if you want the Audit Log to be written to an external file."
msgstr "Позначте цей прапорець, щоб журнал аудиту записувався у зовнішній файл."

#: setup.php
msgid "External Audit Log Format"
msgstr "Формат зовнішнього журналу аудиту"

#: setup.php
msgid "Select the output format for external audit log records."
msgstr "Виберіть формат виведення для зовнішніх записів журналу аудиту."

#: setup.php
msgid "Text"
msgstr "Текст"

#: setup.php
msgid "JSON"
msgstr "JSON"

#: setup.php
msgid "External Audit Log File Path"
msgstr "Шлях до файлу зовнішнього журналу аудиту"

#: setup.php
msgid "Enter the path to the external audit log file."
msgstr "Введіть шлях до зовнішнього файлу журналу аудиту."

#: setup.php
msgid "Authentication Auditing"
msgstr "Аудит автентифікації"

#: setup.php
msgid "Enable Authentication Auditing"
msgstr "Увімкнути аудит автентифікації"

#: setup.php
msgid "Opt in to capture new login, logout, token, password-change, and authorization-denied events from this point forward."
msgstr "Увімкніть збір нових подій входу, виходу, токенів, зміни пароля та відмови в авторизації, починаючи з цього моменту."

#: setup.php
msgid "Enable Failed-login Volume Detection"
msgstr "Увімкнути виявлення обсягу невдалих входів"

#: setup.php
msgid "Emit a global anomaly event when installation-wide failed-login volume exceeds the configured threshold."
msgstr "Генерувати глобальну подію аномалії, коли кількість невдалих входів у межах усієї інсталяції перевищує налаштований поріг."

#: setup.php
msgid "Failed-login Window (minutes)"
msgstr "Вікно обліку невдалих входів (хвилин)"

#: setup.php
msgid "Rolling window in minutes, from 1 through 1440, used to count failed logins."
msgstr "Ковзне вікно в хвилинах (від 1 до 1440), що використовується для підрахунку невдалих входів."

#: setup.php
msgid "Failed-login Volume Threshold"
msgstr "Поріг кількості невдалих входів"

#: setup.php
msgid "Installation-wide failed-login count, from 1 through 1000, that triggers a global anomaly event."
msgstr "Кількість невдалих входів у межах усієї інсталяції (від 1 до 1000), що викликає глобальну подію аномалії."

#: setup.php
msgid "User Log Ingestion Batch Size"
msgstr "Розмір пакета завантаження журналу користувачів"

#: setup.php
msgid "Maximum user_log rows ingested and expired markers reclaimed per poller cycle, from 1 through 5000. Marker state is retained for seven days, so larger batches increase both peak poller work and the bounded seven-day state-table size."
msgstr "Максимум рядків user_log, що приймаються, та прострочених маркерів, що очищуються за один цикл опитувача, від 1 до 5000. Стан маркерів зберігається протягом семи днів, тому більші пакети збільшують як пікове навантаження на опитувач, так і обмежений розмір семиденної таблиці станів."

#: setup.php
msgid "Remote Syslog"
msgstr "Віддалений Syslog"

#: setup.php
msgid "Enable Remote Syslog"
msgstr "Увімкнути віддалений Syslog"

#: setup.php
msgid "Queue finalized audit events for remote Syslog delivery. The existing external file output remains independent."
msgstr "Ставити в чергу завершені події аудиту для віддаленої доставки в Syslog. Наявне виведення у зовнішній файл залишається незалежним."

#: setup.php
msgid "Syslog Receiver"
msgstr "Отримувач Syslog"

#: setup.php
msgid "Enter a receiver hostname or IP address without a URI scheme, path, or credentials."
msgstr "Введіть ім'я хоста або IP-адресу отримувача без схеми URI, шляху чи облікових даних."

#: setup.php
msgid "Syslog Port"
msgstr "Порт Syslog"

#: setup.php
msgid "Enter 1-65535, or leave blank to use 514 for UDP/TCP and 6514 for TLS."
msgstr "Введіть 1-65535 або залиште порожнім, щоб використовувати 514 для UDP/TCP і 6514 для TLS."

#: setup.php
msgid "Syslog Transport"
msgstr "Транспорт Syslog"

#: setup.php
msgid "UDP sends one datagram without acknowledgement. TCP and TLS use RFC 6587 octet-count framing."
msgstr "UDP надсилає одну дейтаграму без підтвердження. TCP і TLS використовують кадрування з підрахунком октетів згідно з RFC 6587."

#: setup.php
msgid "UDP"
msgstr "UDP"

#: setup.php
msgid "TCP"
msgstr "TCP"

#: setup.php
msgid "TLS"
msgstr "TLS"

#: setup.php
msgid "Syslog Payload Format"
msgstr "Формат корисного навантаження Syslog"

#: setup.php
msgid "All formats use an RFC 5424 header. Select RFC 5424 structured data, CEF, or compact JSON for the message."
msgstr "Усі формати використовують заголовок RFC 5424. Виберіть структуровані дані RFC 5424, CEF або компактний JSON для повідомлення."

#: setup.php
msgid "RFC 5424"
msgstr "RFC 5424"

#: setup.php
msgid "CEF"
msgstr "CEF"

#: setup.php
msgid "Syslog Facility"
msgstr "Категорія Syslog (Facility)"

#: setup.php
msgid "Select the facility used to calculate the RFC 5424 priority."
msgstr "Виберіть категорію (facility), що використовується для обчислення пріоритету RFC 5424."

#: setup.php
msgid "Syslog Application Name"
msgstr "Назва програми Syslog"

#: setup.php
msgid "RFC 5424 APP-NAME. Printable non-space ASCII, up to 48 characters."
msgstr "RFC 5424 APP-NAME. Друковані символи ASCII без пробілів, до 48 символів."

#: setup.php
msgid "Audit Node Identity"
msgstr "Ідентифікатор вузла аудиту"

#: setup.php
msgid "Stable RFC 5424 hostname identity for this Cacti node. Do not use a value that changes on restart."
msgstr "Стабільний ідентифікатор імені хоста RFC 5424 для цього вузла Cacti. Не використовуйте значення, яке змінюється під час перезапуску."

#: setup.php
msgid "Connection and Write Timeout"
msgstr "Час очікування підключення та запису"

#: setup.php
msgid "Timeout in seconds, from 1 through 30."
msgstr "Час очікування в секундах, від 1 до 30."

#: setup.php
msgid "Maximum UDP Record Size"
msgstr "Максимальний розмір запису UDP"

#: setup.php
msgid "Records larger than this byte limit are dead-lettered and are never truncated or split. TCP or TLS is recommended for large events."
msgstr "Записи, розмір яких перевищує цей ліміт у байтах, переміщуються до черги недоставлених повідомлень (dead-letter) і ніколи не обрізаються та не розділяються. Для великих подій рекомендується TCP або TLS."

#: setup.php
msgid "Syslog TLS"
msgstr "Syslog TLS"

#: setup.php
msgid "TLS CA File"
msgstr "Файл TLS CA"

#: setup.php
msgid "Optional PEM CA bundle. Peer and hostname verification are always enabled."
msgstr "Необов'язковий пакет сертифікатів ЦС у форматі PEM. Перевірка вузла та імені хоста завжди увімкнена."

#: setup.php
msgid "TLS Client Certificate"
msgstr "Клієнтський сертифікат TLS"

#: setup.php
msgid "Optional PEM client certificate. A client key must also be configured."
msgstr "Необов'язковий сертифікат клієнта у форматі PEM. Також має бути налаштований ключ клієнта."

#: setup.php
msgid "TLS Client Private Key"
msgstr "Закритий ключ клієнта TLS"

#: setup.php
msgid "Optional readable PEM private-key path. The key contents are never stored in audit events."
msgstr "Необов'язковий шлях до доступного для читання закритого ключа у форматі PEM. Вміст ключа ніколи не зберігається в подіях аудиту."

#: setup.php
msgid "Syslog Delivery Queue"
msgstr "Черга доставки Syslog"

#: setup.php
msgid "Retry Base Delay"
msgstr "Базова затримка перед повтором"

#: setup.php
msgid "Initial retry delay in seconds, from 1 through 3600."
msgstr "Початкова затримка повторної спроби в секундах, від 1 до 3600."

#: setup.php
msgid "Maximum Retry Delay"
msgstr "Максимальна затримка повтору"

#: setup.php
msgid "Maximum retry delay in seconds, from the base delay through 86400."
msgstr "Максимальна затримка повтору в секундах, від базової затримки до 86400."

#: setup.php
msgid "Maximum Delivery Attempts"
msgstr "Максимум спроб доставки"

#: setup.php
msgid "Move a record to dead-letter after this many attempts, from 1 through 100."
msgstr "Перемістити запис до черги невиконаних (dead-letter) після цієї кількості спроб, від 1 до 100."

#: setup.php
msgid "Poller Batch Size"
msgstr "Розмір пакета опитувача"

#: setup.php
msgid "Maximum due records processed per poller cycle, from 1 through 1000."
msgstr "Максимум належних до обробки записів за цикл опитувача (від 1 до 1000)."

#: setup.php
msgid "Pending Age Warning"
msgstr "Попередження про тривалість очікування"

#: setup.php
msgid "Show an unhealthy warning when the oldest queued record reaches this age in seconds."
msgstr "Показувати попередження про несправність, коли найстаріший запис у черзі досягає цього віку в секундах."

#: setup.php
msgid "Dead-letter Warning Count"
msgstr "Поріг попередження недоставлених (Dead-letter)"

#: setup.php
msgid "Show an unhealthy warning when this many records are dead-lettered."
msgstr "Показувати попередження про несправність, коли стільки записів потрапили до черги невиконаних (dead-letter)."

#: setup.php
msgid "Audit"
msgstr "Аудит"

#: setup.php
msgid "Audit Event Log"
msgstr "Журнал подій аудиту"

